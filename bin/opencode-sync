#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Sync Claudefiles config to OpenCode via OpenPackage.

Workflow:
  1. Create a temp copy of Claudefiles without .claude/ (triggers opkg misdetection)
  2. Run opkg install targeting the opencode platform
  3. Strip Claude-specific frontmatter fields that have no OpenCode equivalent

Requires: npx (comes with Node.js)

This is being built incrementally against design/specs/1006-oc-native-agents.
T01 laid the script skeleton; T02 added worker agent + config.json generation
(TIER_MAP-driven). Remaining stub points in main():
  - T03: dispatch rewrite, model remap
  - T04: compatibility lint (--lint-only), collision detection, foreign config backup
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import NoReturn

OPKG_VERSION = "0.11.3"

OPENCODE_CONFIG = Path.home() / ".config" / "opencode"

# Tracks which Claudefiles commit was last synced to OpenCode. T01 preserves the
# bash script's plain-text SHA file; FR#16 replaces this with a unified JSON state
# file in a later task (T04), including a one-time migration.
SYNC_SHA_FILE = OPENCODE_CONFIG / ".claudefiles-sync-sha"
SHA_DISPLAY_LEN = 12

# Dirs excluded from staging: .claude/ (causes opkg platform misdetection),
# VCS/caches (.git, __pycache__, node_modules, .venv), and Python packaging/dev
# artifacts (packages, tests, design) that aren't agent config.
EXCLUDE_DIRS = {
    ".claude",
    "__pycache__",
    "node_modules",
    ".git",
    "packages",
    "tests",
    "design",
    ".venv",
}

# Rules that reference Claude-specific harness features with no OpenCode equivalent.
HARNESS_ONLY_RULES = ["sudo.md", "tmux.md"]

# Opkg output lines to surface in non-verbose mode (coupled to opkg's format).
OPKG_SUCCESS_PATTERN = re.compile(r"^✓|Installed files:|No files")

# Single source of truth for model routing: drives worker agent generation,
# config.json generation, and (T03) dispatch rewriting. `opus` has no worker
# entry because no `general-purpose` dispatches currently use opus tier — the
# lint (T04) catches it if one appears. `plan` sits in the sonnet row
# deliberately: Claude Code's model-default hook runs `Plan` at sonnet, and
# pinning it at haiku/luna would be a silent tier downgrade.
TIER_MAP = {
    "opus": {"model": "openai/gpt-5.6-sol", "worker": None, "builtins": []},
    "sonnet": {
        "model": "openai/gpt-5.6-terra",
        "worker": "worker-standard",
        "builtins": ["general", "plan"],
    },
    "haiku": {
        "model": "openai/gpt-5.6-luna",
        "worker": "worker-lightweight",
        "builtins": ["explore", "scout"],
    },
}

# Descriptions for generated worker agents. Keyed by TIER_MAP `worker` value.
WORKER_DESCRIPTIONS = {
    "worker-standard": "Standard worker for implementation, review, and synthesis tasks",
    "worker-lightweight": "Lightweight worker for triage, mechanical analysis, and low-cost tasks",
}

WORKER_AGENT_TEMPLATE = """---
name: {name}
mode: subagent
model: {model}
description: {description}
---
"""

# Depth 2 covers the deepest current workflow (executor -> reviewer); depth 3
# provides one level of headroom for future three-level workflows (FR#7).
SUBAGENT_DEPTH = 3

OPENCODE_COMPAT_RULE = """---
tool: opencode
---

# OpenCode Compatibility

This configuration was developed for Claude Code and adapted for OpenCode. Most rules, skills, and agents work as-is. Where a specific instruction references a Claude Code feature that doesn't exist in OpenCode, use the OpenCode equivalent:

- "AskUserQuestion tool" → use OpenCode's interactive prompting
- "Agent tool with subagent_type" → use OpenCode's agent dispatch
- "Skill tool" → use OpenCode's skill invocation (slash commands)
- "Read/Write/Edit/Grep/Glob tools" → use OpenCode's file tools
- "TaskCreate/TaskUpdate" → use OpenCode's task tracking if available
- "${CLAUDE_CONFIG_DIR:-~/.claude}" paths → ~/.config/opencode
- "PreToolUse/PostToolUse hooks" → OpenCode plugins (tool.execute.before)
- "settings.json" → opencode.json

When an instruction is clearly inapplicable (e.g., references a hook that doesn't exist), skip it silently rather than erroring.
"""


def die(message: str) -> NoReturn:
    print(message, file=sys.stderr)
    sys.exit(1)


def get_claudefiles_dir() -> Path:
    return Path(os.environ.get("CLAUDEFILES_DIR", str(Path.home() / "Claudefiles")))


def check_deps() -> None:
    if shutil.which("npx") is None:
        die("npx not found. Install Node.js.")


def _git_rev_parse(claudefiles: Path, args: list[str]) -> str | None:
    """Run `git rev-parse <args>` in claudefiles. Returns stripped stdout, or None on failure."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", *args],
            cwd=claudefiles,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def in_worktree(claudefiles: Path) -> bool:
    """Detect if claudefiles is a git worktree (not the main working tree).

    --path-format=absolute forces an absolute path; plain --git-common-dir returns a
    *relative* path when run from the repo root (but absolute from a worktree), so
    comparing it against --absolute-git-dir here silently misdetects the main repo as
    a worktree. Do not revert to the plain form.
    """
    git_dir = _git_rev_parse(claudefiles, ["--absolute-git-dir"])
    if git_dir is None:
        return False
    common_dir = _git_rev_parse(
        claudefiles, ["--path-format=absolute", "--git-common-dir"]
    )
    if common_dir is None:
        die(
            "Unable to determine git common dir (requires git >= 2.31); refusing to sync"
        )
    return git_dir != common_dir


def stage_config(claudefiles: Path, tmpdir: Path, *, verbose: bool = False) -> Path:
    """Create a clean staging copy of claudefiles under tmpdir. Returns the staged dir."""
    staged = tmpdir / "claudefiles"
    if verbose:
        print(f"Staging clean copy to {staged}...")

    def ignore(_dir: str, names: list[str]) -> set[str]:
        return {n for n in names if n in EXCLUDE_DIRS}

    shutil.copytree(claudefiles, staged, ignore=ignore)

    for rule in HARNESS_ONLY_RULES:
        (staged / "rules" / "common" / rule).unlink(missing_ok=True)

    compat_path = staged / "rules" / "common" / "opencode-compat.md"
    compat_path.write_text(OPENCODE_COMPAT_RULE)

    return staged


def opkg_list_includes_claudefiles() -> bool:
    try:
        result = subprocess.run(
            [
                "npx",
                "--yes",
                f"opkg@{OPKG_VERSION}",
                "list",
                "-g",
                "--cwd",
                str(Path.home()),
            ],
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
        )
    except (subprocess.TimeoutExpired, OSError):
        return False
    if result.returncode != 0:
        return False
    return re.search(r"\bclaudefiles\b", result.stdout) is not None


def uninstall_previous() -> None:
    """Best-effort uninstall of the previous claudefiles opkg install. Failures are ignored —
    if this fails, the subsequent install still runs; the user reruns on any real problem.
    """
    try:
        subprocess.run(
            [
                "npx",
                "--yes",
                f"opkg@{OPKG_VERSION}",
                "uninstall",
                "claudefiles",
                "-g",
                "--cwd",
                str(Path.home()),
            ],
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
        )
    except (subprocess.TimeoutExpired, OSError):
        pass


def run_opkg(staged_dir: Path, *, dry_run: bool, verbose: bool) -> str:
    """Invoke `opkg install` on the staged directory via npx. Exits non-zero on failure."""
    args = [
        "npx",
        "--yes",
        f"opkg@{OPKG_VERSION}",
        "install",
        str(staged_dir),
        "--platforms",
        "opencode",
        "--cwd",
        str(Path.home()),
        "-g",
        "--force",
    ]
    if dry_run:
        args.append("--dry-run")

    if verbose:
        print(f"Running: {' '.join(args)}")

    try:
        result = subprocess.run(
            args, capture_output=True, text=True, timeout=120, check=False
        )
    except subprocess.TimeoutExpired:
        die("opkg install timed out after 120s")
    except OSError as exc:
        die(f"Failed to run opkg: {exc}")

    if result.returncode != 0:
        print(result.stderr, file=sys.stderr)
        die("opkg install failed")

    output = result.stdout
    if verbose:
        print(output)
        return output

    filtered = "\n".join(
        line for line in output.splitlines() if OPKG_SUCCESS_PATTERN.search(line)
    )
    print(filtered if filtered else output)
    return output


def strip_color_fields(agents_dir: Path) -> None:
    """Remove `color: ` lines from agent frontmatter (FR#10).

    Only lines between the opening pair of `---` markers are touched — body content
    (which may legitimately contain the word "color") is left alone.
    """
    if not agents_dir.is_dir():
        return

    for md_file in sorted(agents_dir.glob("*.md")):
        lines = md_file.read_text().splitlines(keepends=True)
        if not lines or lines[0].strip() != "---":
            continue

        end_idx = None
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                end_idx = i
                break
        if end_idx is None:
            continue

        frontmatter = [
            line for line in lines[1:end_idx] if not line.startswith("color: ")
        ]
        new_lines = lines[:1] + frontmatter + lines[end_idx:]
        if new_lines != lines:
            md_file.write_text("".join(new_lines))


def check_sync_status(claudefiles: Path, sync_sha_file: Path) -> bool:
    """Print sync status and return True if the OpenCode install is current."""
    current_sha = _git_rev_parse(claudefiles, ["HEAD"])
    if current_sha is None:
        die(f"Not a git repo: {claudefiles}")

    stored_sha = sync_sha_file.read_text().strip() if sync_sha_file.exists() else ""

    if current_sha == stored_sha:
        print(f"Up-to-date (synced at {current_sha[:SHA_DISPLAY_LEN]})")
        return True
    if not stored_sha:
        print(f"Never synced (current HEAD: {current_sha[:SHA_DISPLAY_LEN]})")
        return False
    print(
        f"Stale (synced at {stored_sha[:SHA_DISPLAY_LEN]}, "
        f"current HEAD: {current_sha[:SHA_DISPLAY_LEN]})"
    )
    return False


def generate_worker_agents(agents_dir: Path, dry_run: bool) -> list[str]:
    """Generate worker-*.md agent files under agents_dir from TIER_MAP (FR#1).

    Before writing, deletes any existing worker-*.md whose basename doesn't
    correspond to a current TIER_MAP `worker` value — prevents orphaned worker
    agents from lingering after a tier rename. In dry-run mode, prints what
    would be generated/removed without touching the filesystem.

    Returns the list of worker agent names generated.
    """
    current_workers = {
        tier["worker"] for tier in TIER_MAP.values() if tier["worker"] is not None
    }

    if agents_dir.is_dir():
        for existing in sorted(agents_dir.glob("worker-*.md")):
            if existing.stem in current_workers:
                continue
            if dry_run:
                print(f"[dry-run] would remove orphaned worker agent: {existing}")
            else:
                existing.unlink()

    generated = []
    for tier_name, tier in TIER_MAP.items():
        worker = tier["worker"]
        if worker is None:
            continue

        description = WORKER_DESCRIPTIONS.get(worker)
        if description is None:
            die(
                f"No description defined for worker agent {worker!r} (tier {tier_name!r})"
            )

        content = WORKER_AGENT_TEMPLATE.format(
            name=worker, model=tier["model"], description=description
        )
        target = agents_dir / f"{worker}.md"

        if dry_run:
            print(f"[dry-run] would write {target}:\n{content}")
        else:
            agents_dir.mkdir(parents=True, exist_ok=True)
            target.write_text(content)

        generated.append(worker)

    return generated


def build_agent_config() -> dict[str, dict[str, str]]:
    """Build the `agent` mapping of config.json from TIER_MAP.

    Every builtin and worker in TIER_MAP maps to that tier's model. Pinning
    both the built-in subagents and the generated workers at config level (not
    just frontmatter) guards against the frontmatter-ignored failure mode
    (issues #17870/#35126).
    """
    agent_config: dict[str, dict[str, str]] = {}
    for tier in TIER_MAP.values():
        for builtin in tier["builtins"]:
            agent_config[builtin] = {"model": tier["model"]}
        if tier["worker"] is not None:
            agent_config[tier["worker"]] = {"model": tier["model"]}
    return agent_config


def generate_config(config_dir: Path, dry_run: bool) -> None:
    """Generate config.json with model pins and subagent_depth (FR#2, FR#7).

    Written atomically: temp file in the same directory (keeps the final
    os.replace() on the same filesystem) -> json.load() validation -> existing
    file backed up to config.json.bak -> os.replace() into place. A malformed
    config.json would silently wipe all three global config files due to
    OpenCode's single-fallback error handler in loadGlobal().
    """
    config = {
        "$schema": "https://opencode.ai/config.json",
        "agent": build_agent_config(),
        "subagent_depth": SUBAGENT_DEPTH,
    }
    content = json.dumps(config, indent=2) + "\n"
    target = config_dir / "config.json"

    if dry_run:
        print(f"[dry-run] would write {target}:\n{content}")
        return

    config_dir.mkdir(parents=True, exist_ok=True)

    fd, tmp_path_str = tempfile.mkstemp(
        prefix=".config.json.", suffix=".tmp", dir=config_dir
    )
    tmp_path = Path(tmp_path_str)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)

        with tmp_path.open() as f:
            json.load(f)  # validate before it ever becomes the live file

        if target.exists():
            shutil.copy2(target, config_dir / "config.json.bak")

        os.replace(tmp_path, target)
    except BaseException:
        tmp_path.unlink(missing_ok=True)
        raise


def lint_only() -> int:
    """Run the compatibility lint without syncing. Stub — filled in by T04."""
    print("Lint not yet implemented — nothing to check (stub, see T04).")
    return 0


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="opencode-sync",
        description="Sync Claudefiles to OpenCode config via OpenPackage.",
    )
    parser.add_argument(
        "--dry-run",
        "-n",
        action="store_true",
        help="Show what would be installed without writing",
    )
    parser.add_argument("--verbose", "-v", action="store_true", help="Show opkg output")
    parser.add_argument(
        "--allow-worktree",
        action="store_true",
        help="Permit running from a worktree checkout",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check if sync is up-to-date (exit 0=current, 1=stale)",
    )
    parser.add_argument(
        "--lint-only",
        action="store_true",
        help="Run the compatibility lint without syncing (exit 0=clean, non-zero=residual patterns)",
    )
    return parser.parse_args(argv)


def main() -> int:
    args = parse_args()

    if args.check:
        claudefiles = get_claudefiles_dir()
        current = check_sync_status(claudefiles, SYNC_SHA_FILE)
        return 0 if current else 1

    if args.lint_only:
        return lint_only()

    check_deps()

    claudefiles = get_claudefiles_dir()

    if not args.allow_worktree and in_worktree(claudefiles):
        die(
            "Refusing to sync from a worktree (would overwrite live config with "
            "branch state). Use --allow-worktree to override."
        )

    if not claudefiles.is_dir():
        die(f"Claudefiles not found at {claudefiles}")

    tmp_root = os.environ.get("CLAUDE_CODE_TMPDIR", tempfile.gettempdir())
    with tempfile.TemporaryDirectory(
        prefix="opencode-sync-", dir=tmp_root
    ) as tmpdir_str:
        tmpdir = Path(tmpdir_str)

        # Uninstall previous install so deleted skills/agents don't linger as orphans.
        # If the subsequent install fails, the user reruns — no automatic rollback.
        if opkg_list_includes_claudefiles():
            if args.verbose:
                print("Removing previous claudefiles install...")
            if not args.dry_run:
                uninstall_previous()

        staged = stage_config(claudefiles, tmpdir, verbose=args.verbose)

        run_opkg(staged, dry_run=args.dry_run, verbose=args.verbose)

        if not args.dry_run:
            strip_color_fields(OPENCODE_CONFIG / "agents")

        # T03: dispatch rewrite (skills + commands + agent bodies)
        # T03: model remap (agent frontmatter, TIER_MAP-driven, anchored)
        generate_worker_agents(OPENCODE_CONFIG / "agents", dry_run=args.dry_run)
        generate_config(OPENCODE_CONFIG, dry_run=args.dry_run)
        # T04: compatibility lint, run automatically at the end of sync

        if args.dry_run:
            print(
                "\n[dry-run] Dispatch rewrite and model remap are not yet "
                "implemented in this build (see T03) — no-op."
            )
            return 0

        current_sha = _git_rev_parse(claudefiles, ["HEAD"])
        if current_sha is None:
            die(f"Not a git repo: {claudefiles}")
        SYNC_SHA_FILE.parent.mkdir(parents=True, exist_ok=True)
        SYNC_SHA_FILE.write_text(current_sha + "\n")

        print(f"Done. OpenCode config updated at {OPENCODE_CONFIG}")
        return 0


if __name__ == "__main__":
    sys.exit(main())
