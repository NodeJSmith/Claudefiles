#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Manage the OpenCode config plugin for Claudefiles.

OpenCode reads Claudefiles' agents, skills, and rules directly from the live
`~/.claude/` install via a plugin (`opencode/claudefiles.ts`, symlinked into
`~/.config/opencode/`) that populates `cfg.agent`, `cfg.command`, and
`cfg.instructions` in memory at session start -- see
design/specs/1007-opencode-config-plugin/design.md. This script no longer
transports content to disk itself; its job is writing `config.json` (the
plugin declaration and `subagent_depth`) and gating commits against source
drift.

`--check-source` verifies this repo's own dispatch sites (skills/, commands/,
agents/) name a real agent file, flags unsupported platform semantics
(`isolation: "worktree"`, `run_in_background`) and residual Claude-tier
`model:` clauses at dispatch sites, and checks that the shared data file
(`opencode/config-data.json`) and this repo's own `rules/` tree agree.
`--check-orphans` fails if this script itself contains a module-level `def`
or `CONSTANT =` binding referenced nowhere but its own definition line.
"""

import argparse
import ast
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import NoReturn

# Filename for the generated config.json, so generate_config() and any
# assertion elsewhere can't drift on what it's called.
CONFIG_JSON_FILENAME = "config.json"
TMP_FILE_SUFFIX = ".tmp"

# Path to the shared data file relative to this script's own repo root
# (see _load_config_data()).
CONFIG_DATA_RELATIVE_PATH = Path("opencode") / "config-data.json"


def _load_config_data() -> dict:
    """Load opencode/config-data.json: the single source of truth for model
    routing (`tier_map`), allowed reasoning-effort variant names
    (`variants`), rules withheld from OpenCode (`excluded_rules`), and the
    rules subdirectories `cfg.instructions` must name (`instruction_dirs`)
    (FR#27). Read fresh on every call rather than cached at import time --
    this is a `bin/` CLI script invoked once per process, not a hot path,
    and a stale in-memory copy across a long-lived call is a worse failure
    mode than a few extra file reads.

    Resolved relative to this script's own repo root (_script_repo_root(),
    the same resolution check_source() uses): this data belongs to the
    script's own repo, not to whatever checkout an environment-derived home
    directory might point at, so the two must never be allowed to drift
    apart.

    Formerly `OPENCODE_EXCLUDED_RULES` and `INSTRUCTION_DIRS` were Python
    tuple literals hand-copied from this same data -- a hand-copy is
    exactly what FR#27 forbids, since the two copies can silently drift.
    Both are gone; every caller loads through this function instead.
    """
    repo_root = _script_repo_root()
    if repo_root is None:
        die(
            "Unable to determine this script's repo root; cannot load "
            f"{CONFIG_DATA_RELATIVE_PATH}"
        )
    config_data_path = Path(repo_root) / CONFIG_DATA_RELATIVE_PATH
    try:
        return json.loads(config_data_path.read_text())
    except OSError as exc:
        die(f"Unable to read {config_data_path}: {exc}")
    except json.JSONDecodeError as exc:
        die(f"{config_data_path} is not valid JSON: {exc}")


# Depth 2 covers the deepest current workflow (executor -> reviewer); depth 3
# provides one level of headroom for future three-level workflows (FR#7).
SUBAGENT_DEPTH = 3


def die(message: str) -> NoReturn:
    print(message, file=sys.stderr)
    sys.exit(1)


# Vars git sets on every hook invocation (pre-commit, prek's hook-impl) to
# pin the hook to the repo/worktree/index that triggered it. Confirmed
# empirically that their presence breaks cwd-based discovery: with GIT_DIR
# set, `git -C bin rev-parse --show-toplevel` returns `bin` itself instead
# of walking up to the real repo root -- once GIT_DIR is explicit, git treats
# cwd as the work tree root rather than discovering it. Every call site here
# passes an explicit directory it wants resolved *from*, so ambient hook
# environment must never be allowed to override that.
_GIT_ENV_OVERRIDE_VARS = (
    "GIT_DIR",
    "GIT_WORK_TREE",
    "GIT_INDEX_FILE",
    "GIT_PREFIX",
    "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_COMMON_DIR",
)


def _git_rev_parse(claudefiles: Path, args: list[str]) -> str | None:
    """Run `git rev-parse <args>` in claudefiles. Returns stripped stdout, or
    None on failure. Strips _GIT_ENV_OVERRIDE_VARS from the subprocess
    environment first -- see that constant's comment.
    """
    env = {k: v for k, v in os.environ.items() if k not in _GIT_ENV_OVERRIDE_VARS}
    try:
        result = subprocess.run(
            ["git", "rev-parse", *args],
            cwd=claudefiles,
            capture_output=True,
            text=True,
            check=False,
            env=env,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def _script_repo_root() -> str | None:
    """Resolve the git repo root containing this script file -- "what repo
    is the running script actually in," which check_source() below needs,
    rather than a runtime-configurable checkout location.
    """
    return _git_rev_parse(Path(__file__).resolve().parent, ["--show-toplevel"])


def find_unmatched_rule_exclusions(rules_root: Path) -> list[str]:
    """Return every `excluded_rules` entry (opencode/config-data.json) that
    matches no file under `rules_root`, without touching the filesystem.

    Non-mutating: nothing stages a copy of the repo to delete matched files
    from anymore -- the plugin filters exclusions at runtime, and this now
    runs only as a commit-time check (FR#8) against the repo's own `rules/`
    tree, from check_source_dispatch_patterns(). Formerly named
    `apply_rule_exclusions()` and deleted matched files as a side effect of
    a staging step that no longer exists.

    An unmatched entry means the source rule was renamed or moved, which
    would silently re-admit it to the sync -- callers surface that rather
    than ignoring it.
    """
    excluded = _load_config_data()["excluded_rules"]
    return [relative for relative in excluded if not (rules_root / relative).is_file()]


def _split_frontmatter(content: str) -> tuple[str, str]:
    """Split a leading YAML frontmatter block (between the first two `---`
    lines) off from the rest of the file. Returns (frontmatter_incl_markers,
    body); if there's no frontmatter block, returns ("", content) unchanged.
    """
    lines = content.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        return "", content

    end_idx = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            end_idx = i
            break
    if end_idx is None:
        return "", content

    return "".join(lines[: end_idx + 1]), "".join(lines[end_idx + 1 :])


def _atomic_write(target: Path, data: bytes) -> None:
    """Write `data` to `target` atomically: tempfile in the same directory
    (keeps the final os.replace() on the same filesystem) -> fsync ->
    os.replace() into place. The tempfile is removed on any exception.

    The fsync matters: os.replace() only guarantees the rename itself is
    atomic (no torn file mid-rename), not that the new content has actually
    reached disk. Without it, an unclean shutdown between the write and the
    kernel's next background flush can still leave the replaced file
    truncated or stale after reboot -- silently defeating the reason this
    helper exists (see generate_config(), its one remaining caller).
    """
    fd, tmp_path_str = tempfile.mkstemp(
        prefix=f".{target.name}.", suffix=TMP_FILE_SUFFIX, dir=target.parent
    )
    tmp_path = Path(tmp_path_str)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, target)
    except BaseException:
        tmp_path.unlink(missing_ok=True)
        raise


def generate_config(config_dir: Path) -> str:
    """Generate config.json declaring the plugin and subagent_depth (FR#7,
    FR#17).

    Carries no `agent` key: OpenCode resolves every agent's model and
    reasoning variant from that agent's own frontmatter, mediated by the
    plugin's tier remap at `config()` time -- a config-level pin would only
    duplicate what the plugin already supplies. The prior config-level
    pinning existed to guard against a "frontmatter is ignored" failure mode
    that turned out to be misattributed -- issues #17870/#35126 describe
    subagents inheriting the *parent's* active model, not frontmatter being
    ignored, and #35126 was closed with the maintainer confirming frontmatter
    is honored through the task tool (design/specs/1008-opencode-named-roles/
    design.md, Dependencies and Assumptions).

    `plugin` names the symlinked claudefiles.ts by its bare filename --
    path-like plugin specs resolve relative to the declaring config file, so
    no absolute path is needed here.

    Written atomically via _atomic_write(): a malformed config.json
    collapses all three global OpenCode config files to empty (OpenCode's
    single-fallback error handler in loadGlobal()), taking opencode.jsonc's
    machine-local `permission` and `mcp` settings down with it for that
    process -- so the write must never leave a torn file behind even though
    the content itself is now generated and small.

    Never touches opencode.jsonc (FR#18): that file is the machine-local
    overlay for `permission` and `mcp`, owned by the user, and this function
    writes only `config_dir / "config.json"`.
    """
    config = {
        "$schema": "https://opencode.ai/config.json",
        "plugin": ["claudefiles.ts"],
        "subagent_depth": SUBAGENT_DEPTH,
    }
    content = json.dumps(config, indent=2) + "\n"
    target = config_dir / CONFIG_JSON_FILENAME

    config_dir.mkdir(parents=True, exist_ok=True)
    _atomic_write(target, content.encode())
    return content


# Patterns for unsupported platform semantics -- warnings, not errors, since
# OpenCode simply can't honor these rather than the source being wrong.
# Scanned by check_source_dispatch_patterns() (FR#23) over this repo's own
# skills/commands/agents, not over installed output -- these flag a property
# of the source.
ISOLATION_WORKTREE_RE = re.compile(r"""isolation:\s*["']worktree["']""")
RUN_IN_BACKGROUND_RE = re.compile(r"run_in_background")

# Matches a `subagent_type:` clause naming the dispatched agent, optionally
# wrapped in a single matching pair of backtick and/or quote characters:
# `subagent_type: code-reviewer`, subagent_type: "code-reviewer". Used by
# check_source_dispatch_patterns() (FR#18) to verify every dispatched name
# has a file in agents/ -- unlike the dispatch-translation regexes this
# replaces, there is no model-tier pairing logic here, because a dispatch no
# longer carries one.
DISPATCH_NAME_RE = re.compile(
    r"(?P<btopen>`)?"
    r"subagent_type:\s*"
    r"(?P<qopen>[\"'])?"
    r"(?P<name>[A-Za-z][A-Za-z0-9_-]*)"
    r"(?(qopen)(?P=qopen))"
    r"(?(btopen)`)"
)

# Matches the `cfl dispatch <role> --agent-type <name>` telemetry-form
# dispatch shape -- the second of the three dispatch shapes named in this
# migration's design as in-scope for FR#18's validity gate (the third,
# bare-prose mentions with no `subagent_type:` or `--agent-type` literal, is
# a documented, permanent gap -- see design.md's Dependencies and
# Assumptions). Unlike `DISPATCH_NAME_RE`, `--agent-type` is unambiguously a
# dispatch (no prose-vs-mention disambiguation problem), so no backtick/quote
# wrapping needs to be tolerated.
DISPATCH_AGENT_TYPE_FLAG_RE = re.compile(
    r"--agent-type\s+(?P<name>[A-Za-z][A-Za-z0-9_-]*)"
)

# Matches a residual `model:` clause naming a Claude tier at a dispatch site
# (FR#2's invariant, checked at commit time by check_source_dispatch_patterns()
# rather than left to AC#2's external grep alone). Model tier belongs in the
# agent's own frontmatter now, not the call site.
DISPATCH_MODEL_CLAUSE_RE = re.compile(
    r"(?:\*\*)?model(?:\*\*)?:\s*[`\"']?(sonnet|haiku|opus)\b", re.IGNORECASE
)


def check_instruction_directory_coverage(rules_root: Path) -> list[str]:
    """Return an error per subdirectory under `rules_root` that the shared
    instruction-directory list (opencode/config-data.json's
    `instruction_dirs`) does not name.

    Retargeted (T03) from "is every synced rules directory covered by an
    `instructions` glob in config.json" -- a question about disk transport
    this script no longer performs -- to "is every subdirectory under this
    repo's own `rules/` named in the shared instruction-directory list": the
    plugin (opencode/claudefiles.ts) reads `~/.claude/rules/{common,
    personal}` directly and emits explicit `instructions` paths, not globs,
    so there is nothing left to glob. A rules subdirectory this repo (or
    Dotfiles, via the live install) adds but the shared list doesn't name
    still reaches disk but is invisible to `cfg.instructions` -- this turns
    that silence into a commit-time error instead.

    `rules_root` is the root itself (e.g. `claudefiles/"rules"`), not its
    parent -- the caller no longer needs a separate INSTRUCTION_ROOT
    constant to derive it, since there is exactly one caller and it already
    has the path in hand.

    Only directories that directly contain a `.md` file count: an empty or
    purely structural directory has nothing to load and shouldn't fail the
    check.

    Scoped to this repo's own `rules/` tree, not a live `~/.claude/rules/`
    install: pointing this commit-time gate at a live install would break
    check_source()'s reproducible-on-a-fresh-checkout contract (see its
    docstring). This repo's `rules/` has only `common/` -- `rules/personal/`
    exists solely as five Dotfiles symlinks in the installed union, so this
    check cannot see it. Accepted limitation, recorded in design.md's
    Dependencies and Assumptions.
    """
    if not rules_root.is_dir():
        return []

    instruction_dirs = _load_config_data()["instruction_dirs"]
    covered = {rules_root.parent / directory for directory in instruction_dirs}
    errors = []
    for candidate in sorted(rules_root.rglob("*")):
        if not candidate.is_dir() or candidate in covered:
            continue
        if not any(candidate.glob("*.md")):
            continue
        relative = candidate.relative_to(rules_root.parent)
        errors.append(
            f"{candidate}: synced rules directory has no entry in the shared "
            "instruction-directory list -- its rules are on disk but never "
            f'loaded. Add "{relative}" to instruction_dirs in '
            "opencode/config-data.json."
        )
    return errors


def check_source_dispatch_patterns(claudefiles: Path) -> tuple[list[str], list[str]]:
    """Verify every dispatch in this repo's own skills/commands/agents names
    an agent with a file in agents/, that no dispatch site carries a raw
    Claude tier `model:` clause, that this repo's own `rules/` tree agrees
    with opencode/config-data.json's `excluded_rules` and
    `instruction_dirs` lists, and that every `tier_map` entry in that same
    shared file names a variant OpenCode resolves (FR#8, FR#18, FR#21,
    FR#23, FR#27).

    Covers both the `subagent_type:` clause form (DISPATCH_NAME_RE) and the
    `cfl dispatch ... --agent-type <name>` telemetry form
    (DISPATCH_AGENT_TYPE_FLAG_RE). Bare-prose mentions of an agent name with
    neither literal present are not checked -- see design.md's Dependencies
    and Assumptions for why that shape is a documented, permanent gap rather
    than an oversight.

    Also collects warnings for Claude-only dispatch semantics OpenCode
    cannot honor (`isolation: "worktree"`, `run_in_background`), scanned
    over the same three directories -- moved here (T03) from the retired
    installed-file lint, since these are a property of the source, not of a
    disk-synced copy.

    With no dispatch rewriter, this reads source directly instead of
    staging a scratch tree and rewriting it first -- there is nothing to
    rewrite, and nothing residual to compare against what a rewriter would
    have produced. `rules/` used to need a scratch copy because
    apply_rule_exclusions() deleted matched files as a side effect of
    staging; its replacement, find_unmatched_rule_exclusions(), only reads,
    so it and check_instruction_directory_coverage() both run directly
    against `claudefiles / "rules"` now.

    Returns an `(errors, warnings)` pair that check_source() below reports
    inline -- the shared reporter this and the installed-file lint used to
    both feed retired along with that lint, leaving check_source() as the
    one remaining caller.

    Returns a single synthetic error (not a raised exception, so
    check_source() still prints and exits non-zero the normal way) if none
    of skills/, commands/, or agents/ exist -- silently scanning nothing
    would otherwise report a false-positive clean pass.
    """
    warnings: list[str] = []

    found_any = any(
        (claudefiles / name).is_dir() for name in ("skills", "commands", "agents")
    )
    if not found_any:
        return (
            [f"No skills/, commands/, or agents/ directory found under {claudefiles}"],
            warnings,
        )

    agents_dir = claudefiles / "agents"
    known_agents = (
        {p.stem for p in agents_dir.glob("*.md")} if agents_dir.is_dir() else set()
    )

    errors: list[str] = []
    for subdir_name in ("skills", "commands", "agents"):
        subdir = claudefiles / subdir_name
        if not subdir.is_dir():
            continue
        for md_file in sorted(subdir.rglob("*.md")):
            content = md_file.read_text()
            # An agent file's own frontmatter is FR#7's declaration site, not
            # a dispatch site -- its `model:` line legitimately names a
            # Claude tier (agents/researcher.md is the only agent file with
            # real dispatches, and they live in its body). Exclude
            # frontmatter here for the same reason, or every agent file's
            # own declaration trips the residual-model-clause check on
            # itself.
            line_offset = 0
            if subdir_name == "agents":
                frontmatter, content = _split_frontmatter(content)
                line_offset = frontmatter.count("\n")
            for i, line in enumerate(content.splitlines()):
                lineno = i + 1 + line_offset
                for match in DISPATCH_NAME_RE.finditer(line):
                    name = match.group("name")
                    if name not in known_agents:
                        errors.append(
                            f"{md_file}:{lineno}: dispatch names {name!r}, which "
                            "has no file in agents/"
                        )
                for match in DISPATCH_AGENT_TYPE_FLAG_RE.finditer(line):
                    name = match.group("name")
                    if name not in known_agents:
                        errors.append(
                            f"{md_file}:{lineno}: --agent-type names {name!r}, "
                            "which has no file in agents/"
                        )
                for match in DISPATCH_MODEL_CLAUSE_RE.finditer(line):
                    errors.append(
                        f"{md_file}:{lineno}: residual `model: {match.group(1)}` "
                        "tier clause at a dispatch site -- model tier belongs in "
                        "the agent's own frontmatter, not the call site"
                    )
                if ISOLATION_WORKTREE_RE.search(line):
                    warnings.append(
                        f'{md_file}:{lineno}: `isolation: "worktree"` has no '
                        "OpenCode equivalent"
                    )
                if RUN_IN_BACKGROUND_RE.search(line):
                    warnings.append(
                        f"{md_file}:{lineno}: `run_in_background` is unsupported "
                        "(experimental in OpenCode)"
                    )

    # `rules/` is not dispatch-scanned above (the loop only covers
    # skills/commands/agents), but check_instruction_directory_coverage()
    # returns nothing at all when `rules/` is absent -- so without this
    # block the gate stayed clean no matter how many rules directories went
    # uncovered, blind to the exact miss it was added to catch. Not part of
    # found_any: a repo with rules/ but none of the three dispatch
    # directories still has nothing to check above.
    rules_src = claudefiles / "rules"
    if rules_src.is_dir():
        errors.extend(
            f"opencode/config-data.json's excluded_rules lists rules/{relative}, "
            "which does not exist. A renamed or moved rule silently starts "
            "syncing to OpenCode -- update the entry in opencode/config-data.json."
            for relative in find_unmatched_rule_exclusions(rules_src)
        )
        errors.extend(check_instruction_directory_coverage(rules_src))

    # Pure data check (FR#27): every variant a tier resolves to must be one
    # OpenCode itself resolves, the same failure mode `check_variant_names()`
    # used to guard in synced agent files (bug #514) -- now checked against
    # the shared data file directly, since the tier map is authored there
    # and nowhere else reachable at commit time.
    config_data = _load_config_data()
    allowed_variants = set(config_data["variants"])
    for tier, entry in config_data["tier_map"].items():
        variant = entry["variant"]
        if variant not in allowed_variants:
            errors.append(
                f"opencode/config-data.json's tier_map[{tier!r}] has variant "
                f"{variant!r}, which is not in the allowed variants list. "
                f"Expected one of: {sorted(allowed_variants)}."
            )

    return errors, warnings


def check_source() -> int:
    """Entry point for `--check-source`: verify this repo's own dispatch
    sites resolve, not a live install (FR#18, FR#21).

    Uses the repo containing this script file (_script_repo_root()) rather
    than a $HOME-derived checkout path: in GitHub Actions, for instance, the
    checkout lands under the workspace path, not $HOME, so resolving from
    the script's own location is what keeps this reproducible on a fresh
    checkout regardless of environment.

    Reports errors and warnings inline rather than through a shared
    reporter function -- the one that used to serve this alongside the
    installed-file lint retired with that lint, and this is its only
    remaining caller.
    """
    script_root = _script_repo_root()
    if script_root is None:
        die("Unable to determine this script's repo root; refusing to check-source")

    errors, warnings = check_source_dispatch_patterns(Path(script_root))

    for warning in warnings:
        print(f"WARNING: {warning}")
    for error in errors:
        print(f"ERROR: {error}", file=sys.stderr)

    if errors:
        print(
            f"\nCheck failed: {len(errors)} error(s), {len(warnings)} warning(s).",
            file=sys.stderr,
        )
        return 1

    print(f"Check clean: 0 errors, {len(warnings)} warning(s).")
    return 0


def find_orphaned_definitions(source: str) -> list[str]:
    """Return the name of every module-level function or ALL_CAPS constant
    binding in `source` whose name appears exactly once in the file -- on
    its own definition line and nowhere else (FR#25).

    Scoped to module-level `def`/`async def` statements and top-level
    assignments whose single target is an ALL_CAPS name (this repo's
    constant-naming convention, e.g. `SUBAGENT_DEPTH`, `CONFIG_JSON_FILENAME`)
    -- not every assignment, which would also flag ordinary locals; those never
    reach this loop because only `tree.body` (module-level statements) is
    walked, not nested function bodies.

    Counts raw substring occurrences of the name across the whole file
    (including comments and docstrings), not just executable references. A
    docstring that still mentions a deleted function's name by way of
    explaining why it was removed will therefore not flag that function as
    orphaned if the name reappears there -- a deliberate lean towards fewer
    false positives, since the purpose of this check is catching a helper
    nobody looked at again, not enforcing that every reference is a live
    call.
    """
    tree = ast.parse(source)
    names: list[str] = []
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            names.append(node.name)
        elif isinstance(node, ast.Assign) and len(node.targets) == 1:
            target = node.targets[0]
            if isinstance(target, ast.Name) and target.id.isupper():
                names.append(target.id)

    orphans = []
    for name in names:
        if len(re.findall(rf"\b{re.escape(name)}\b", source)) <= 1:
            orphans.append(name)
    return orphans


def check_orphans(script_path: Path) -> list[str]:
    """Return every orphaned module-level definition in `script_path`.

    Thin filesystem wrapper around find_orphaned_definitions() so the
    name-counting logic stays independently testable against synthetic
    source rather than requiring a real file on disk.
    """
    return find_orphaned_definitions(script_path.read_text())


def check_orphans_entry() -> int:
    """Entry point for `--check-orphans`: fail if this script itself
    contains a stranded module-level definition (FR#25).

    Enumerating each deletion wave's removal targets by hand has repeatedly
    missed one (see design/specs/1008-opencode-named-roles/design.md,
    Architecture: "What leaves bin/opencode-sync") -- this replaces that
    hand-kept list with a mechanism the next deletion wave gets for free.
    """
    orphans = check_orphans(Path(__file__).resolve())
    for name in orphans:
        print(
            f"ERROR: {name!r} is defined but never referenced elsewhere in this file",
            file=sys.stderr,
        )
    if orphans:
        print(f"\n{len(orphans)} orphaned definition(s) found.", file=sys.stderr)
        return 1
    print("No orphaned definitions found.")
    return 0


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="opencode-sync",
        description="Manage the OpenCode config plugin for Claudefiles.",
    )
    parser.add_argument(
        "--check-source",
        action="store_true",
        help=(
            "Verify every dispatch in this repo's own skills/commands/agents "
            "names an agent with a file in agents/, without a live OpenCode "
            "install (exit 0=clean, non-zero=unresolvable dispatch)"
        ),
    )
    parser.add_argument(
        "--check-orphans",
        action="store_true",
        help=(
            "Fail if this script contains a module-level def or CONSTANT = "
            "binding referenced nowhere but its own definition line "
            "(exit 0=clean, non-zero=orphan found)"
        ),
    )
    return parser.parse_args(argv)


def main() -> int:
    args = parse_args()

    if args.check_source:
        return check_source()

    if args.check_orphans:
        return check_orphans_entry()

    print(
        "No action requested. Use --check-source or --check-orphans.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
