#!/usr/bin/env python3
"""Report the facts that decide whether a repo's git worktrees are finished, and remove approved ones.

Squash-merges leave merged branches looking unmerged, so ancestry alone can't
say a branch is done. For each worktree this reports its PR (gh on GitHub,
ado-api on Azure DevOps), whether the branch tip is still the PR's last
commit, commits ahead of the default branch, uncommitted, untracked and
gitignored files (gitignored ones because git deletes them without asking),
whether the remote branch still exists, and when it was last active.
It reports the same branch facts for local branches no worktree has checked
out, which are left behind when a worktree is removed without its branch.

It reports and never decides. Judging what's safe to remove is left to the
reader. `remove` without --force relies on git refusing any worktree that
still has uncommitted or untracked files (git does not protect ignored ones),
and always refuses a worktree that contains a nested worktree not also selected.

Usage:
  git-worktree-audit [-C <repo>] [--json] [--no-fetch]
  git-worktree-audit [-C <repo>] remove [--force] [--delete-branch] <path>...

Exit codes: 0 ok, 1 runtime failure (not a repo, default branch unresolved,
a removal failed), 2 usage error.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from collections.abc import Callable
from concurrent.futures import ThreadPoolExecutor
from dataclasses import asdict, dataclass
from pathlib import Path

SECONDS_PER_DAY = 86400
LOOKUP_WORKERS = 8
EXIT_RUNTIME = 1
BIN_DIR = Path(__file__).resolve().parent
GH_STATES = {"OPEN": "open", "MERGED": "merged", "CLOSED": "closed"}
REMOTE = "origin"
PR_LOOKUP_LIMIT = "20"
ADO_STATES = {"active": "open", "completed": "merged", "abandoned": "closed"}
# Gitignored caches that rebuild themselves; other ignored paths are reported because git deletes them silently.
REGENERABLE = {
    "node_modules",
    ".venv",
    "venv",
    "__pycache__",
    ".pytest_cache",
    ".ruff_cache",
    ".mypy_cache",
    ".tox",
    ".nox",
    ".cache",
    "dist",
    "build",
    "target",
    "dbt_packages",
    ".next",
    ".turbo",
    ".vite",
    "htmlcov",
    "spark-warehouse",
    ".databricks",
    ".codegraph",
    ".coverage",
    ".DS_Store",
}


@dataclass(frozen=True)
class PullRequest:
    id: str
    state: str  # open | merged | closed
    head: str | None  # the PR's last source commit, when the platform reports it
    author: str
    url: str


@dataclass
class Branch:
    """A local branch that no worktree, the main clone included, has checked out."""

    branch: str
    head: str
    age_days: float | None = None  # since the tip's commit
    ahead_of_default: int | None = None  # None: couldn't be computed
    remote_branch: bool = False
    pr: PullRequest | None = None
    tip_is_pr_head: bool | None = None  # None: no PR, or the PR's head is unknown
    error: str | None = None


@dataclass
class Worktree:
    path: str
    branch: str | None
    head: str | None
    missing: bool = False
    age_days: float | None = None  # since the last commit or checkout in this worktree
    in_use: bool = False  # a running process has its cwd inside it (Linux only)
    # None: unknown (the directory is gone, or `git status` failed)
    tracked_changes: list[str] | None = None
    untracked: list[str] | None = None
    ignored: list[str] | None = (
        None  # gitignored paths, minus REGENERABLE caches; git deletes these without asking
    )
    ahead_of_default: int | None = None  # None: couldn't be computed
    remote_branch: bool = False
    pr: PullRequest | None = None
    tip_is_pr_head: bool | None = None  # None: no PR, or the PR's head is unknown
    error: str | None = None


def git(repo: str | Path, *args: str, allow_fail: bool = False) -> str:
    """Run git in `repo`. With allow_fail, a failure returns "" instead of raising."""
    result = subprocess.run(
        ["git", "-C", str(repo), *args], capture_output=True, text=True
    )
    if result.returncode != 0:
        if allow_fail:
            return ""
        raise RuntimeError(f"git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout


def git_ok(repo: str | Path, *args: str) -> bool:
    return (
        subprocess.run(["git", "-C", str(repo), *args], capture_output=True).returncode
        == 0
    )


def list_worktrees(repo: str | Path) -> tuple[dict, list[dict]]:
    """Return (main clone entry, other entries). Git always lists the main working tree first."""
    entries, current = [], {}
    for line in git(repo, "worktree", "list", "--porcelain").splitlines():
        if not line:
            if current:
                entries.append(current)
            current = {}
            continue
        key, _, value = line.partition(" ")
        current[key] = value or True
    if current:
        entries.append(current)
    return entries[0], entries[1:]


def branch_of(entry: dict) -> str | None:
    ref = entry.get("branch")
    return ref.removeprefix("refs/heads/") if isinstance(ref, str) else None


def resolve_base(main_clone: Path) -> str:
    """The default branch, as origin/<name> when that ref exists. Raises rather than guess."""
    result = subprocess.run(
        [str(BIN_DIR / "git-default-branch"), "--no-network"],
        cwd=main_clone,
        capture_output=True,
        text=True,
    )
    name = result.stdout.strip() if result.returncode == 0 else ""
    if not name:
        raise RuntimeError(
            "could not resolve the default branch (try `git remote set-head origin --auto`)"
        )
    for candidate in (f"{REMOTE}/{name}", name):
        if git_ok(
            main_clone, "rev-parse", "--verify", "--quiet", f"{candidate}^{{commit}}"
        ):
            return candidate
    raise RuntimeError(f"default branch {name!r} has no local or origin ref")


def lookup_pr_github(main_clone: Path, branch: str) -> PullRequest | None:
    out = subprocess.run(
        [
            "gh",
            "pr",
            "list",
            "--state",
            "all",
            "--head",
            branch,
            "--limit",
            PR_LOOKUP_LIMIT,
            "--json",
            "number,state,headRefOid,url,createdAt,author",
        ],
        cwd=main_clone,
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    prs = sorted(json.loads(out), key=lambda p: p["createdAt"])
    if not prs:
        return None
    p = prs[-1]
    author = (p.get("author") or {}).get("login", "")
    return PullRequest(
        str(p["number"]),
        GH_STATES.get(p["state"], p["state"].lower()),
        p["headRefOid"],
        author,
        p["url"],
    )


def lookup_pr_ado(main_clone: Path, branch: str) -> PullRequest | None:
    out = subprocess.run(
        [
            "ado-api",
            "pr",
            "list",
            "--json",
            "--status",
            "all",
            "--source",
            branch,
            "--top",
            PR_LOOKUP_LIMIT,
        ],
        cwd=main_clone,
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    prs = sorted(json.loads(out), key=lambda p: p["creationDate"])
    if not prs:
        return None
    p = prs[-1]
    state = ADO_STATES.get(p["status"], p["status"].lower())
    return PullRequest(
        str(p["id"]), state, p.get("sourceCommit"), p.get("author", ""), p["url"]
    )


def pr_lookup_for(main_clone: Path) -> Callable[[str], PullRequest | None] | None:
    """A branch -> PR lookup for the repo's platform, or None when it can't look PRs up."""
    result = subprocess.run(
        [str(BIN_DIR / "git-platform"), "-C", str(main_clone)],
        capture_output=True,
        text=True,
    )
    kind = result.stdout.strip()
    if kind == "github" and shutil.which("gh"):
        return lambda branch: lookup_pr_github(main_clone, branch)
    if kind == "ado" and shutil.which("ado-api"):
        return lambda branch: lookup_pr_ado(main_clone, branch)
    return None


def cwds_of_running_processes() -> list[Path]:
    proc = Path("/proc")
    if not proc.is_dir():
        return []
    cwds = []
    for entry in proc.iterdir():
        if entry.name.isdigit():
            try:
                cwds.append(Path(os.readlink(entry / "cwd")))
            except OSError:
                continue
    return cwds


def last_activity(path: Path) -> int | None:
    """Time of the worktree's last commit or checkout, from its newest reflog entry.

    File mtimes are no signal: `git status` rewrites the index and `git gc` rewrites the reflog files.
    """
    entry = git(
        path, "reflog", "-1", "--date=unix", "--format=%gd", "HEAD", allow_fail=True
    )
    stamp = entry.strip().removeprefix("HEAD@{").removesuffix("}")
    if not stamp.isdigit():
        stamp = git(path, "log", "-1", "--format=%ct", allow_fail=True).strip()
    return int(stamp) if stamp.isdigit() else None


def parse_status(raw: str) -> tuple[list[str], list[str], list[str]]:
    """Split `git status --porcelain=v1 -z --ignored` output into (tracked changes, untracked, ignored)."""
    tracked, untracked, ignored = [], [], []
    tokens = iter(raw.split("\0"))
    for token in tokens:
        if not token:
            continue
        code, rel = token[:2], token[3:]
        if code == "??":
            untracked.append(rel)
        elif code == "!!":
            ignored.append(rel)
        else:
            tracked.append(rel)
            if "R" in code or "C" in code:
                next(tokens, None)  # -z puts a rename's source path in its own field
    return tracked, untracked, ignored


def is_regenerable(rel: str) -> bool:
    parts = rel.rstrip("/").split("/")
    return any(
        p in REGENERABLE or p.endswith(".egg-info") or p.startswith(".venv")
        for p in parts
    ) or rel.endswith(".pyc")


def fill_branch_facts(
    target: Worktree | Branch, main_clone: Path, base: str, lookup, errors: list[str]
) -> None:
    """Fill in commits ahead, remote branch, and PR facts, shared by worktrees and bare branches."""
    # A missing worktree's branch is still in the main clone; refs/heads/ keeps a same-named tag out.
    rev = f"refs/heads/{target.branch}" if target.branch else target.head
    if rev:
        ahead = git(
            main_clone, "rev-list", "--count", f"{base}..{rev}", allow_fail=True
        ).strip()
        target.ahead_of_default = int(ahead) if ahead.isdigit() else None
    if not target.branch:
        return
    target.remote_branch = git_ok(
        main_clone,
        "show-ref",
        "--verify",
        "--quiet",
        f"refs/remotes/{REMOTE}/{target.branch}",
    )
    if lookup:
        try:
            target.pr = lookup(target.branch)
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as e:
            errors.append(f"PR lookup: {type(e).__name__}: {e}")
        if target.pr and target.pr.head:
            target.tip_is_pr_head = target.pr.head == target.head


def gather_branch(br: Branch, main_clone: Path, base: str, lookup, now: float) -> None:
    errors: list[str] = []
    fill_branch_facts(br, main_clone, base, lookup, errors)
    stamp = git(
        main_clone, "log", "-1", "--format=%ct", br.head, allow_fail=True
    ).strip()
    br.age_days = (
        round((now - int(stamp)) / SECONDS_PER_DAY, 1) if stamp.isdigit() else None
    )
    br.error = "; ".join(errors) or None


def gather(
    wt: Worktree, main_clone: Path, base: str, lookup, cwds: list[Path], now: float
) -> None:
    """Fill in a worktree's facts. Anything that fails stays None, and the first error is recorded."""
    errors: list[str] = []
    fill_branch_facts(wt, main_clone, base, lookup, errors)
    if not wt.missing:
        path = Path(wt.path)
        resolved = path.resolve()
        wt.in_use = any(c == resolved or resolved in c.parents for c in cwds)
        try:
            stamp = last_activity(path)
            wt.age_days = (
                None if stamp is None else round((now - stamp) / SECONDS_PER_DAY, 1)
            )
            raw = git(
                path,
                "--no-optional-locks",
                "status",
                "--porcelain=v1",
                "-z",
                "--untracked-files=all",
                "--ignored=matching",
            )
            wt.tracked_changes, wt.untracked, ignored = parse_status(raw)
            wt.ignored = [p for p in ignored if not is_regenerable(p)]
        except (RuntimeError, OSError) as e:
            errors.append(f"{type(e).__name__}: {e}")
    wt.error = "; ".join(errors) or None


def unattached_branches(
    main_clone: Path, main_entry: dict, entries: list[dict], base: str
) -> list[Branch]:
    """Local branches no worktree has checked out, minus the default branch.

    A worktree stopped mid-rebase lists as detached, so its branch comes from the rebase state instead.
    """
    checked_out = {
        branch_of(e) or rebasing_branch(e["worktree"]) for e in (main_entry, *entries)
    }
    default = base.removeprefix(f"{REMOTE}/")
    out = git(
        main_clone,
        "for-each-ref",
        "refs/heads",
        # refname:short becomes heads/<name> when a tag shares the name
        "--format=%(refname:lstrip=2) %(objectname)",
    )
    branches = []
    for line in out.splitlines():
        name, _, head = line.rpartition(" ")
        if name and name not in checked_out and name != default:
            branches.append(Branch(branch=name, head=head))
    return branches


def rebasing_branch(path: str) -> str | None:
    """The branch a worktree is rebasing, from the rebase state git keeps in its git dir."""
    git_dir = git(path, "rev-parse", "--absolute-git-dir", allow_fail=True).strip()
    if not git_dir:
        return None
    for state in ("rebase-merge", "rebase-apply"):
        head_name = Path(git_dir, state, "head-name")
        if head_name.is_file():
            return head_name.read_text().strip().removeprefix("refs/heads/")
    return None


def audit(repo: str | Path, fetch: bool, pr_lookup=None) -> dict:
    """Facts for every worktree except the main clone, plus local branches no worktree has checked out. Pass `pr_lookup` to replace platform detection."""
    main_entry, entries = list_worktrees(repo)
    main_clone = Path(main_entry["worktree"]).resolve()
    fetched = None  # None: not attempted; False: attempted and failed
    if fetch:
        fetched = git_ok(main_clone, "fetch", "--prune", "--quiet", REMOTE)
        if not fetched:
            print(
                "warning: git fetch failed; remote state may be stale", file=sys.stderr
            )
    base = resolve_base(main_clone)
    worktrees = [
        Worktree(
            path=e["worktree"],
            branch=branch_of(e),
            head=e.get("HEAD"),
            missing=not Path(e["worktree"]).is_dir(),
        )
        for e in entries
    ]
    branches = unattached_branches(main_clone, main_entry, entries, base)
    lookup = pr_lookup if pr_lookup is not None else pr_lookup_for(main_clone)
    cwds = cwds_of_running_processes()
    now = time.time()
    with ThreadPoolExecutor(LOOKUP_WORKERS) as pool:
        list(
            pool.map(
                lambda w: gather(w, main_clone, base, lookup, cwds, now), worktrees
            )
        )
        list(
            pool.map(
                lambda b: gather_branch(b, main_clone, base, lookup, now), branches
            )
        )
    for items in (worktrees, branches):
        items.sort(key=oldest_first)
    return {
        "repo": str(main_clone),
        "default_branch": base,
        "fetched": fetched,
        "pr_lookup": lookup is not None,
        "worktrees": [asdict(w) for w in worktrees],
        "branches": [asdict(b) for b in branches],
    }


def oldest_first(item: Worktree | Branch) -> float:
    return -(item.age_days if item.age_days is not None else float("inf"))


def count(paths: list[str] | None) -> str:
    return "?" if paths is None else str(len(paths))


def print_table(report: dict) -> None:
    root = report["repo"] + "/"
    rows = []
    for w in report["worktrees"]:
        pr = f"{w['pr']['id']}:{w['pr']['state']}" if w["pr"] else "-"
        tip = {True: "pr-head", False: "moved", None: "-"}[w["tip_is_pr_head"]]
        notes = [
            n
            for n, on in (("in use", w["in_use"]), ("remote", w["remote_branch"]))
            if on
        ]
        if w["error"]:
            notes.append(f"error: {w['error']}")
        rows.append(
            (
                w["branch"] or "(detached)",
                "gone"
                if w["missing"]
                else "?"
                if w["age_days"] is None
                else f"{w['age_days']:.0f}d",
                pr,
                tip,
                "?" if w["ahead_of_default"] is None else str(w["ahead_of_default"]),
                count(w["tracked_changes"]),
                count(w["untracked"]),
                count(w["ignored"]),
                w["path"].removeprefix(root),
                ", ".join(notes),
            )
        )
    headers = (
        "BRANCH",
        "AGE",
        "PR",
        "TIP",
        "AHEAD",
        "DIRTY",
        "UNTRACKED",
        "IGNORED",
        "PATH",
        "NOTES",
    )
    print_rows(headers, rows)
    print(
        f"\n{len(rows)} worktrees; AHEAD counts commits not on {report['default_branch']}"
    )
    if report["branches"]:
        branch_rows = [
            (
                b["branch"],
                "?" if b["age_days"] is None else f"{b['age_days']:.0f}d",
                f"{b['pr']['id']}:{b['pr']['state']}" if b["pr"] else "-",
                {True: "pr-head", False: "moved", None: "-"}[b["tip_is_pr_head"]],
                "?" if b["ahead_of_default"] is None else str(b["ahead_of_default"]),
                ", ".join(
                    (["remote"] if b["remote_branch"] else [])
                    + ([f"error: {b['error']}"] if b["error"] else [])
                ),
            )
            for b in report["branches"]
        ]
        print("\nLocal branches with no worktree (AGE is since the tip's commit):")
        print_rows(("BRANCH", "AGE", "PR", "TIP", "AHEAD", "NOTES"), branch_rows)
    if not report["pr_lookup"]:
        print(
            "PR lookup unavailable (unknown platform, or gh/ado-api not installed)",
            file=sys.stderr,
        )


def print_rows(headers: tuple[str, ...], rows: list[tuple[str, ...]]) -> None:
    widths = [max([len(h), *(len(r[i]) for r in rows)]) for i, h in enumerate(headers)]
    for row in (headers, *rows):
        print(
            "  ".join(
                c if i == len(row) - 1 else c.ljust(widths[i])
                for i, c in enumerate(row)
            ).rstrip()
        )


def remove(repo: str | Path, paths: list[str], force: bool, delete_branch: bool) -> int:
    """Remove worktrees deepest-first so nested ones go before their parents."""
    main_entry, entries = list_worktrees(repo)
    main_clone = Path(main_entry["worktree"]).resolve()
    known = {str(Path(e["worktree"]).resolve()): e for e in entries}
    targets = {str(Path(p).resolve()) for p in paths}
    removed: set[str] = set()
    failures = 0
    for path in sorted(targets, key=lambda p: -len(Path(p).parts)):
        entry = known.get(path)
        # Any worktree still inside this one (unselected, or selected but refused) would go with it:
        # git can't see a nested worktree under a gitignored dir like .claude/.
        nested = [
            k for k in known if Path(path) in Path(k).parents and k not in removed
        ]
        if not entry:
            problem = f"not a worktree of {main_clone}"
        elif nested:
            problem = f"still contains nested worktree(s): {', '.join(nested)}"
        else:
            args = ["worktree", "remove", *(["--force"] if force else []), path]
            result = subprocess.run(
                ["git", "-C", str(main_clone), *args], capture_output=True, text=True
            )
            problem = result.stderr.strip() if result.returncode != 0 else None
        if problem:
            print(f"failed  {path}: {problem}", file=sys.stderr)
            failures += 1
            continue
        removed.add(path)
        remove_empty_parents(Path(path), main_clone)
        print(f"removed {path}")
        branch = branch_of(entry)
        if delete_branch and branch:
            if git_ok(main_clone, "branch", "-D", branch):
                print(f"deleted branch {branch}")
            else:
                print(
                    f"failed  branch {branch}: git branch -D refused", file=sys.stderr
                )
                failures += 1
    git(main_clone, "worktree", "prune", allow_fail=True)
    return EXIT_RUNTIME if failures else 0


def remove_empty_parents(path: Path, stop: Path) -> None:
    """Delete empty directories above `path` up to the main clone (branch names with slashes leave them)."""
    parent = path.parent
    while stop in parent.parents:
        try:
            parent.rmdir()
        except OSError:
            return
        parent = parent.parent


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="git-worktree-audit",
        description="Report the facts that decide whether each worktree is finished; remove approved ones.",
        epilog="Exit codes: 0 ok, 1 runtime failure (not a repo, default branch unresolved, "
        "a removal failed), 2 usage error.",
    )
    parser.add_argument(
        "-C",
        dest="repo",
        default=".",
        help="repo to inspect (default: current directory)",
    )
    parser.add_argument(
        "--json", action="store_true", help="print the full report as JSON"
    )
    parser.add_argument(
        "--no-fetch", action="store_true", help="skip `git fetch --prune origin`"
    )
    sub = parser.add_subparsers(dest="command")
    rm = sub.add_parser("remove", help="remove worktrees, nested ones first")
    rm.add_argument(
        "-C", dest="repo", default=argparse.SUPPRESS, help="same as the top-level -C"
    )
    rm.add_argument("paths", nargs="+", help="worktree paths to remove")
    rm.add_argument(
        "--force",
        action="store_true",
        help="remove even with uncommitted or untracked files",
    )
    rm.add_argument(
        "--delete-branch",
        action="store_true",
        help="also force-delete each worktree's local branch",
    )
    args = parser.parse_args()

    if not git_ok(args.repo, "rev-parse", "--git-dir"):
        print(f"error: {args.repo} is not a git repository", file=sys.stderr)
        return EXIT_RUNTIME
    try:
        if args.command == "remove":
            return remove(args.repo, args.paths, args.force, args.delete_branch)
        report = audit(args.repo, fetch=not args.no_fetch)
    except RuntimeError as e:
        print(f"error: {e}", file=sys.stderr)
        return EXIT_RUNTIME
    if args.json:
        json.dump(report, sys.stdout, indent=2)
        print()
    else:
        print_table(report)
    return 0


if __name__ == "__main__":
    sys.exit(main())
