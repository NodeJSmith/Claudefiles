#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""List everything on a GitHub PR that may need a response.

Three surfaces: inline review threads (resolvable), review bodies, and PR
conversation comments. Every surface is fully paginated, including the comments
inside each thread. Messages on a known-noise denylist are left out of the
surfaces but listed under `excluded` with a reason; anything unrecognized is
kept, because a dropped finding is invisible while an extra item costs one
triage line.
"""

import argparse
import json
import re
import subprocess
import sys
from collections import Counter
from collections.abc import Callable

GH_TIMEOUT_SECONDS = 60
PAGE_SIZE = 100
THREAD_PREVIEW_CHARS = 150
REVIEW_PREVIEW_CHARS = 400

REVIEW_COMMENTS_KEY = "reviewComments"
ISSUE_COMMENTS_KEY = "issueComments"

REVIEW_FIELDS = "author { login __typename } state url body createdAt"
ISSUE_COMMENT_FIELDS = "databaseId author { login __typename } url body createdAt"
THREAD_COMMENT_FIELDS = (
    "id databaseId body author { login __typename } createdAt updatedAt"
)
REACTION_FIELDS = "content user { login } createdAt"

FIRST_PAGE_QUERY = f"""
query($owner: String!, $repo: String!, $pr: Int!, $after: String) {{
  repository(owner: $owner, name: $repo) {{
    pullRequest(number: $pr) {{
      title
      url
      reactions(first: {PAGE_SIZE}) {{ pageInfo {{ hasNextPage endCursor }} nodes {{ {REACTION_FIELDS} }} }}
      reviews(first: {PAGE_SIZE}) {{ pageInfo {{ hasNextPage endCursor }} nodes {{ {REVIEW_FIELDS} }} }}
      comments(first: {PAGE_SIZE}) {{ pageInfo {{ hasNextPage endCursor }} nodes {{ {ISSUE_COMMENT_FIELDS} }} }}
      reviewThreads(first: {PAGE_SIZE}, after: $after) {{
        pageInfo {{ hasNextPage endCursor }}
        nodes {{
          id isResolved isOutdated path line startLine diffSide
          comments(first: {PAGE_SIZE}) {{
            pageInfo {{ hasNextPage endCursor }}
            nodes {{ {THREAD_COMMENT_FIELDS} }}
          }}
        }}
      }}
    }}
  }}
}}
"""

# Filled per call with .format() rather than an f-string: the connection name
# and its node fields differ between call sites (reviews, comments, reactions).
PR_CONNECTION_QUERY = """
query($owner: String!, $repo: String!, $pr: Int!, $after: String!) {{
  repository(owner: $owner, name: $repo) {{
    pullRequest(number: $pr) {{
      {field}(first: {size}, after: $after) {{ pageInfo {{ hasNextPage endCursor }} nodes {{ {fields} }} }}
    }}
  }}
}}
"""

THREAD_COMMENTS_QUERY = f"""
query($id: ID!, $after: String!) {{
  node(id: $id) {{
    ... on PullRequestReviewThread {{
      comments(first: {PAGE_SIZE}, after: $after) {{
        pageInfo {{ hasNextPage endCursor }}
        nodes {{ {THREAD_COMMENT_FIELDS} }}
      }}
    }}
  }}
}}
"""

CODEX_LOGIN = "chatgpt-codex-connector"
CODERABBIT_LOGIN = "coderabbitai"

# Codex's review body when its findings are all inline threads. Anchored to the
# whole body, and the About block may not contain another </details>, so a Codex
# body carrying anything extra (a finding, a second <details>) is not matched.
CODEX_BOILERPLATE_RE = re.compile(
    r"\A\s*### 💡 Codex Review\s+"
    r"Here are some automated review suggestions for this pull request\.\s+"
    r"\*\*Reviewed commit:\*\* `[0-9a-f]+`\s*"
    r"<details>\s*<summary>ℹ️ About Codex in GitHub</summary>"
    r"(?:(?!</details>)[\s\S])*</details>\s*\Z"
)
REVIEW_TRIGGER_RE = re.compile(
    rf"\A\s*@({CODERABBIT_LOGIN}|codex)\s+((full|security)\s+)?review\s*\Z",
    re.IGNORECASE,
)

# Known-noise denylist: (reason, predicate on (author login, body)). Each rule
# matches a stable identity (bot login plus its marker) or an entire body.
# Deliberately absent: CodeRabbit's walkthrough comment (its pre-merge checks
# can report failures), CodeRabbit chat replies, and CodeRabbit review bodies
# (they carry outside-diff/duplicate/nitpick findings that exist nowhere else).
NOISE_RULES: list[tuple[str, Callable[[str, str], bool]]] = [
    ("Codecov coverage report", lambda login, body: login.startswith("codecov")),
    (
        "Codex review status table",
        lambda login, body: (
            login == CODEX_LOGIN
            and body.lstrip().startswith("<!-- codex-pull-request-review-summary -->")
        ),
    ),
    (
        "Codex review boilerplate (its findings are inline threads)",
        lambda login, body: (
            login == CODEX_LOGIN and CODEX_BOILERPLATE_RE.match(body) is not None
        ),
    ),
    (
        "ReadTheDocs build preview",
        lambda login, body: (
            login == "read-the-docs-community"
            and body.lstrip().startswith("<!-- readthedocs-")
        ),
    ),
    (
        "review trigger command",
        lambda login, body: REVIEW_TRIGGER_RE.match(body) is not None,
    ),
    (
        "CodeRabbit review-command acknowledgement",
        lambda login, body: (
            login == CODERABBIT_LOGIN
            and "<!-- CodeRabbit review command invocation:" in body
        ),
    ),
]


def noise_reason(node: dict) -> str | None:
    login = (node.get("author") or {}).get("login") or ""
    body = node.get("body") or ""
    for reason, matches in NOISE_RULES:
        if matches(login, body):
            return reason
    return None


def split_noise(nodes: list[dict], surface: str) -> tuple[list[dict], list[dict]]:
    """Split one surface into (kept, excluded). Empty bodies carry no content and are skipped."""
    kept, excluded = [], []
    for node in nodes:
        if not (node.get("body") or "").strip():
            continue
        reason = noise_reason(node)
        if reason is None:
            kept.append(node)
        else:
            author = (node.get("author") or {}).get("login")
            excluded.append(
                {
                    "surface": surface,
                    "author": author,
                    "url": node.get("url"),
                    "reason": reason,
                }
            )
    return kept, excluded


def gh(*args: str) -> str:
    try:
        result = subprocess.run(
            ["gh", *args],
            capture_output=True,
            text=True,
            timeout=GH_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired:
        sys.exit(f"error: gh {args[0]} timed out after {GH_TIMEOUT_SECONDS}s")
    if result.returncode != 0:
        sys.exit(
            result.stderr.strip() or f"error: gh {args[0]} exited {result.returncode}"
        )
    return result.stdout


def graphql(query: str, **variables: str | int) -> dict:
    args = ["api", "graphql", "-f", f"query={query}"]
    for key, value in variables.items():
        args += ["-F" if isinstance(value, int) else "-f", f"{key}={value}"]
    response = json.loads(gh(*args))
    # gh api graphql does not exit non-zero on GraphQL-level errors.
    if response.get("errors"):
        sys.exit(response["errors"][0].get("message", "unknown GraphQL error"))
    return response["data"]


def drain(first_page: dict, fetch_next: Callable[[str], dict]) -> list[dict]:
    """Follow a connection's cursor to the end, starting from a page already in hand."""
    nodes = list(first_page["nodes"])
    page = first_page
    while page["pageInfo"]["hasNextPage"] and page["pageInfo"]["endCursor"]:
        page = fetch_next(page["pageInfo"]["endCursor"])
        nodes += page["nodes"]
    return nodes


def fetch_pr(owner: str, repo: str, pr: int) -> dict:
    """Fetch the PR with every thread, thread comment, review, and conversation comment."""
    pr_vars = {"owner": owner, "repo": repo, "pr": pr}
    first = graphql(FIRST_PAGE_QUERY, **pr_vars)["repository"]["pullRequest"]

    threads = drain(
        first["reviewThreads"],
        lambda after: graphql(FIRST_PAGE_QUERY, **pr_vars, after=after)["repository"][
            "pullRequest"
        ]["reviewThreads"],
    )
    for thread in threads:
        # tid= binds this thread's id when the lambda is created; a bare
        # thread["id"] in the body would be looked up at call time instead.
        thread["comments"] = {
            "nodes": drain(
                thread["comments"],
                lambda after, tid=thread["id"]: graphql(
                    THREAD_COMMENTS_QUERY, id=tid, after=after
                )["node"]["comments"],
            )
        }

    def connection(field: str, fields: str) -> list[dict]:
        query = PR_CONNECTION_QUERY.format(field=field, size=PAGE_SIZE, fields=fields)
        return drain(
            first[field],
            lambda after: graphql(query, **pr_vars, after=after)["repository"][
                "pullRequest"
            ][field],
        )

    return {
        "title": first["title"],
        "url": first["url"],
        "reactions": connection("reactions", REACTION_FIELDS),
        "threads": threads,
        "reviews": connection("reviews", REVIEW_FIELDS),
        "comments": connection("comments", ISSUE_COMMENT_FIELDS),
    }


def build_report(pr: dict, show_all: bool) -> dict:
    review_comments, excluded_review_comments = split_noise(
        pr["reviews"], REVIEW_COMMENTS_KEY
    )
    issue_comments, excluded_issue_comments = split_noise(
        pr["comments"], ISSUE_COMMENTS_KEY
    )

    # Each reviewer's latest verdict, so "reviewed, no findings" differs from "not reviewed yet".
    # Built from the UNFILTERED reviews on purpose: a denylisted body (Codex
    # boilerplate) is still proof that the reviewer ran.
    latest: dict[str, dict] = {}
    for review in sorted(pr["reviews"], key=lambda r: r["createdAt"]):
        author = (review.get("author") or {}).get("login")
        latest[author] = {
            "author": author,
            "state": review["state"],
            "createdAt": review["createdAt"],
            "url": review["url"],
        }

    threads = pr["threads"]
    resolved = sum(1 for thread in threads if thread["isResolved"])
    return {
        "pr": {"title": pr["title"], "url": pr["url"]},
        "threads": threads
        if show_all
        else [thread for thread in threads if not thread["isResolved"]],
        # Counted over ALL threads regardless of --all, so an empty .threads in
        # unresolved-only mode can be told apart from "findings exist but got resolved".
        "threadCounts": {
            "total": len(threads),
            "resolved": resolved,
            "unresolved": len(threads) - resolved,
        },
        "reactions": [
            {
                "user": (r.get("user") or {}).get("login"),
                "reaction": r["content"],
                "createdAt": r["createdAt"],
            }
            for r in pr["reactions"]
        ],
        "reviews": sorted(latest.values(), key=lambda r: r["author"] or ""),
        REVIEW_COMMENTS_KEY: review_comments,
        ISSUE_COMMENTS_KEY: issue_comments,
        "excluded": excluded_review_comments + excluded_issue_comments,
    }


EMOJI = {
    "THUMBS_UP": "👍",
    "THUMBS_DOWN": "👎",
    "LAUGH": "😄",
    "HOORAY": "🎉",
    "CONFUSED": "😕",
    "HEART": "❤️",
    "ROCKET": "🚀",
    "EYES": "👀",
}


def one_line(text: str, limit: int) -> str:
    return (text or "")[:limit].replace("\n", " ")


def render_text(report: dict, show_all: bool) -> str:
    counts = report["threadCounts"]
    lines = [
        f"PR: {report['pr']['title']}",
        f"URL: {report['pr']['url']}",
        f"Total threads: {counts['total']}, Unresolved: {counts['unresolved']}",
        "",
    ]
    for thread in report["threads"]:
        first = thread["comments"]["nodes"][0] if thread["comments"]["nodes"] else {}
        flags = (" [RESOLVED]" if show_all and thread["isResolved"] else "") + (
            " [OUTDATED]" if thread["isOutdated"] else ""
        )
        lines += [
            f"{thread['path']}:{thread['line'] or '?'} [{thread['id']}]{flags} (comment: {first.get('databaseId')})",
            f"  @{(first.get('author') or {}).get('login')}: {one_line(first.get('body'), THREAD_PREVIEW_CHARS)}",
            "",
        ]

    def section(title: str, rows: list[str]) -> None:
        if rows:
            lines.extend([f"── {title} ──", *rows, ""])

    section(
        "Reactions",
        [
            f"  @{r['user']}: {EMOJI.get(r['reaction'], r['reaction'])}"
            for r in report["reactions"]
        ],
    )
    section(
        "Review status",
        [f"  @{review['author']}: {review['state']}" for review in report["reviews"]],
    )

    def entry(header: str, body: str) -> list[str]:
        return [header, f"  {one_line(body, REVIEW_PREVIEW_CHARS)}", ""]

    def entries(items: list[dict], header: Callable[[dict], str]) -> list[str]:
        return [line for item in items for line in entry(header(item), item["body"])]

    section(
        "Review bodies (not threads)",
        entries(
            report["reviewComments"],
            lambda review: (
                f"@{(review.get('author') or {}).get('login')} [{review['state']}] {review['url']}"
            ),
        ),
    )
    section(
        "Conversation comments (not threads)",
        entries(
            report["issueComments"],
            lambda c: f"@{(c.get('author') or {}).get('login')} {c['url']}",
        ),
    )
    reasons = Counter(e["reason"] for e in report["excluded"])
    section(
        f"Excluded as known noise ({len(report['excluded'])})",
        [f"  {n}x {reason}" for reason, n in reasons.items()],
    )
    return "\n".join(lines).rstrip("\n")


def resolve_target(
    repo_flag: str | None, pr_number: int | None
) -> tuple[str, str, int]:
    if repo_flag:
        if "/" not in repo_flag:
            sys.exit(f"error: --repo value must be OWNER/REPO (got: {repo_flag})")
        nwo = repo_flag
    else:
        nwo = gh(
            "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"
        ).strip()
    if pr_number is None:
        repo_args = ["-R", nwo] if repo_flag else []
        pr_number = int(
            gh("pr", "view", *repo_args, "--json", "number", "-q", ".number").strip()
        )
    owner, name = nwo.split("/", 1)
    return owner, name, pr_number


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="gh-pr-threads",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="""\
List everything on a PR that may need a response: inline review threads, plus
review bodies and conversation comments that aren't inline threads.

The non-thread surfaces matter because CodeRabbit posts substantial findings
("Outside diff range comments", "Duplicate comments") in review bodies rather
than inline threads. Every surface is fully paginated. Only messages on a
known-noise denylist (Codecov reports, Codex status/boilerplate, ReadTheDocs
previews, bare "@coderabbitai review" triggers) are left out, and each one is
listed under .excluded with its reason; anything unrecognized is kept.

Only inline threads are resolvable (PRRT_ ids). Review bodies and
conversation comments are informational — reply with a normal PR comment.

If no PR number given, auto-detects from current branch.""",
        epilog="""\
Examples:
  gh-pr-threads                  # unresolved threads on current branch's PR
  gh-pr-threads 42               # unresolved threads on PR #42
  gh-pr-threads --all 42         # all threads (including resolved) on PR #42
  gh-pr-threads --json 42        # raw JSON output for scripting
  gh-pr-threads 42 --json --all  # combine flags in any order
  gh-pr-threads 134 -R NodeJSmith/otf-api""",
    )
    parser.add_argument(
        "pr_number",
        nargs="?",
        type=int,
        help="PR number (default: current branch's PR)",
    )
    parser.add_argument(
        "-R",
        "--repo",
        help="Target a specific repository as OWNER/REPO (default: current repo)",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit a JSON object: {pr, threads, threadCounts, reactions, reviews, reviewComments, issueComments, excluded}",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Include resolved threads (default: unresolved only)",
    )
    args = parser.parse_args()

    owner, name, pr_number = resolve_target(args.repo, args.pr_number)
    report = build_report(fetch_pr(owner, name, pr_number), args.all)
    print(
        json.dumps(report, ensure_ascii=False)
        if args.json
        else render_text(report, args.all)
    )


if __name__ == "__main__":
    main()
