#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///
"""Generate and validate the two artifacts derived from agent frontmatter.

Each agent's own frontmatter (`agents/*.md`) is the single declaration site
for its model, effort, tools, description, and bundle membership. Two other
files carry a *generated* view of that same data, produced by this script:

  - `rules/common/performance.md`'s "Agent files:" bullet list
  - `install.py`'s per-bundle `agents=(...)` tuples

This script is both the generator and the pre-commit gate:

  - `bin/lint-agent-models`          check mode (default, the pre-commit
                                      hook): reject any agent file missing a
                                      required frontmatter field, regenerate
                                      both artifacts in memory, and fail if
                                      either diverges from what is on disk.
  - `bin/lint-agent-models --write`  regenerate both artifacts and save them.

Generation runs one way, outward from frontmatter -- never the reverse.
Agent files are never written by this script.

Parses install.py's source with regexes rather than importing it, to stay
stdlib-only: install.py pulls in rich/questionary that the pre-commit
environment does not provide. Bundle agent tuples are flat
`agents=("a", "b", ...)` literals with no nested parens, which is what makes
a non-greedy `[^)]*` capture reliable -- generated output must preserve that
flatness or this script stops being able to re-read what it wrote.

Wired as a repo:local pre-commit hook. Exit 0 on success, 1 with details.
"""

import argparse
import re
import sys
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

REQUIRED_FIELDS = ("model", "effort", "tools", "description", "bundle")

# Every agent's `tools:` list must be a superset of this floor (design.md
# AC#19) -- the fleet-wide widening this script's callers migrated to
# treats per-agent restriction as a fiction not worth re-litigating per
# file, so every agent gets the same baseline plus whatever it needs on top.
TOOLS_BASELINE = ("Read", "Write", "Edit", "Bash", "Grep", "Glob")

# Detects a bare `tools:` line with nothing after it -- block-style YAML
# (`tools:\n  - Read\n  - Write`). FIELD_PATTERNS["tools"] only matches
# flow-style (`tools: ["Read", "Write"]`), so without this a block-style
# list would otherwise be misreported as a *missing* required field rather
# than a present-but-wrong-format one.
TOOLS_BLOCK_STYLE_RE = re.compile(r"^tools:\s*$", re.MULTILINE)

# `model:` gets its own pattern (rather than a generic one from the loop below)
# because it is the only field whose trailing `# ...` comment carries meaning
# this script reads: an em-dash-separated annotation such as "do not
# downgrade; pre-commit safety gate" (agents/code-reviewer.md:3). Plain
# version-stamp comments ("# claude-sonnet-5 as of 2026-07-07") have no
# em dash and produce no annotation.
MODEL_LINE_RE = re.compile(
    r"^model:\s*(?P<model>\w+)(?:\s*#\s*(?P<comment>.*))?$", re.MULTILINE
)
FIELD_PATTERNS: dict[str, re.Pattern[str]] = {
    "model": MODEL_LINE_RE,
    "effort": re.compile(r"^effort:\s*(?P<value>\w+)\s*$", re.MULTILINE),
    # The gap before the value is `[ \t]*`, not `\s*` -- `\s` matches
    # newlines too, which let this cross onto the next line and capture a
    # block-style list's first item ("- Read") as a bogus single-line value
    # instead of failing to match. Restricting the gap to same-line
    # whitespace makes block-style correctly fail to match here, so it is
    # reported as missing rather than silently misparsed.
    "tools": re.compile(r"^tools:[ \t]*(?P<value>.+\S)\s*$", re.MULTILINE),
    "description": re.compile(r"^description:\s*(?P<value>.+\S)\s*$", re.MULTILINE),
    "bundle": re.compile(r"^bundle:\s*(?P<value>\S+)\s*$", re.MULTILINE),
}

# Bundle agent tuples are flat `agents=("a", "b", ...)` literals -- no nested
# parens -- so `[^)]*` reliably captures each tuple body (see module
# docstring). BUNDLE_KEY_RE matches the `"<key>": Bundle(` line that opens
# each bundle's dataclass literal in install.py's get_bundles(); pairing it
# with AGENTS_TUPLE_RE by document order is how a tuple gets attributed to
# the bundle key it belongs to (there is no other structural marker).
BUNDLE_KEY_RE = re.compile(r'^\s*"([\w-]+)":\s*Bundle\(\s*$', re.MULTILINE)
AGENTS_TUPLE_RE = re.compile(r"agents=\(([^)]*)\)", re.DOTALL)

PERF_REGION_START = (
    "<!-- GENERATED BY bin/lint-agent-models -- DO NOT EDIT MANUALLY. "
    "Run `bin/lint-agent-models --write` to regenerate. -->"
)
PERF_REGION_END = "<!-- END GENERATED -->"

INSTALL_REGION_START = (
    "# GENERATED BY bin/lint-agent-models -- DO NOT EDIT MANUALLY. "
    "Run `bin/lint-agent-models --write` to regenerate."
)
INSTALL_REGION_END = "# END GENERATED"
# install.py's literal nesting for a bundle's `agents=(` tuple: dict -> Bundle(
# -> agents=( is 3 levels of 4-space indent (12) for the closing paren, plus one
# more level (16) for each item inside it. If install.py's bundle-dict nesting
# ever changes depth, these two constants must change with it -- there is no
# mechanism that derives them from the actual file.
INSTALL_ITEM_INDENT = " " * 16
INSTALL_CLOSE_INDENT = " " * 12


@dataclass(frozen=True)
class AgentInfo:
    stem: str
    model: str
    effort: str
    bundle: str
    annotation: str | None


def split_frontmatter(text: str) -> str:
    # Splitting on "---" yields ["", frontmatter, body] for a well-formed file.
    parts = text.split("---", 2)
    return parts[1] if len(parts) >= 3 and text.startswith("---") else ""


def load_agents(agents_dir: Path) -> tuple[list[AgentInfo], list[str]]:
    """Parse every agents/*.md frontmatter into an AgentInfo, or an error.

    Returns (agents, errors). A file missing a required field is excluded
    from `agents` -- there is nothing complete to generate from -- and
    reported in `errors`, naming both the file and the missing field(s)
    (FR#23).
    """
    agents: list[AgentInfo] = []
    errors: list[str] = []
    for path in sorted(agents_dir.glob("*.md")):
        fm = split_frontmatter(path.read_text())
        missing = [f for f in REQUIRED_FIELDS if not FIELD_PATTERNS[f].search(fm)]

        if "tools" in missing and TOOLS_BLOCK_STYLE_RE.search(fm):
            errors.append(
                f"agents/{path.name}: `tools:` uses block-style YAML; this "
                'repo requires flow-style (tools: ["Read", "Write", ...]) '
                "so lint-agent-models can parse it"
            )
            continue

        if missing:
            errors.append(
                f"agents/{path.name}: missing required frontmatter field(s): "
                f"{', '.join(missing)}"
            )
            continue

        model_match = MODEL_LINE_RE.search(fm)
        assert model_match is not None  # guaranteed by the `missing` check above
        model = model_match.group("model")
        comment = (model_match.group("comment") or "").strip()
        annotation = comment.split("—", 1)[1].strip() if "—" in comment else None

        effort_match = FIELD_PATTERNS["effort"].search(fm)
        bundle_match = FIELD_PATTERNS["bundle"].search(fm)
        assert effort_match is not None and bundle_match is not None
        effort = effort_match.group("value")
        bundle = bundle_match.group("value")

        tools_match = FIELD_PATTERNS["tools"].search(fm)
        assert tools_match is not None  # guaranteed: not missing, not block-style
        tool_names = set(re.findall(r'"([^"]+)"', tools_match.group("value")))
        missing_baseline = [t for t in TOOLS_BASELINE if t not in tool_names]
        if missing_baseline:
            errors.append(
                f"agents/{path.name}: tools: missing baseline tool(s): "
                f"{', '.join(missing_baseline)}"
            )
            continue

        agents.append(
            AgentInfo(
                stem=path.stem,
                model=model,
                effort=effort,
                bundle=bundle,
                annotation=annotation,
            )
        )

    return agents, errors


def render_performance_block(agents: list[AgentInfo]) -> str:
    """Render the "Agent files:" bullet list, sorted by stem for determinism."""
    lines = [PERF_REGION_START]
    for agent in sorted(agents, key=lambda a: a.stem):
        line = f"- `agents/{agent.stem}.md` — {agent.model}, {agent.effort}"
        if agent.annotation:
            line += f" ({agent.annotation})"
        lines.append(line)
    lines.append(PERF_REGION_END)
    return "\n".join(lines)


def replace_marked_region(
    text: str, start_marker: str, end_marker: str, new_body: str
) -> str | None:
    """Replace the text between (and including) start_marker/end_marker.

    Returns None if either marker is missing from `text` -- the caller
    treats that as an error rather than silently doing nothing, since a file
    missing its generated-region markers can't be regenerated into.
    """
    start_idx = text.find(start_marker)
    if start_idx == -1:
        return None
    end_idx = text.find(end_marker, start_idx)
    if end_idx == -1:
        return None
    end_idx += len(end_marker)
    return text[:start_idx] + new_body + text[end_idx:]


def find_bundle_tuple_spans(install_text: str) -> dict[str, tuple[int, int]]:
    """Map each bundle key to the (start, end) span of its `agents=(...)` body.

    Walks bundle-key headers and `agents=(...)` tuples in document order,
    attributing each tuple to the most recently seen key. Bundles with no
    `agents=` field (e.g. frontend, cli) are simply absent from the result.
    """
    events: list[tuple[int, str, str | tuple[int, int]]] = []
    for m in BUNDLE_KEY_RE.finditer(install_text):
        events.append((m.start(), "key", m.group(1)))
    for m in AGENTS_TUPLE_RE.finditer(install_text):
        events.append((m.start(), "tuple", m.span(1)))
    events.sort(key=lambda e: e[0])

    spans: dict[str, tuple[int, int]] = {}
    current_key: str | None = None
    for _, kind, payload in events:
        if kind == "key":
            assert isinstance(payload, str)
            current_key = payload
        elif current_key is not None:
            assert isinstance(payload, tuple)
            spans[current_key] = payload
    return spans


def render_install_tuple_body(names: list[str]) -> str:
    lines = [f"{INSTALL_ITEM_INDENT}{INSTALL_REGION_START}"]
    lines += [f'{INSTALL_ITEM_INDENT}"{name}",' for name in sorted(names)]
    lines.append(f"{INSTALL_ITEM_INDENT}{INSTALL_REGION_END}")
    return "\n" + "\n".join(lines) + "\n" + INSTALL_CLOSE_INDENT


def regenerate_install_py(
    install_text: str, agents: list[AgentInfo]
) -> tuple[str | None, list[str]]:
    """Return (new_text, errors). new_text is None when errors is non-empty."""
    spans = find_bundle_tuple_spans(install_text)
    grouped: dict[str, list[str]] = {}
    for agent in agents:
        grouped.setdefault(agent.bundle, []).append(agent.stem)

    errors = [
        f"install.py: bundle '{bundle}' (declared by agents/{stems[0]}.md"
        + (f" and {len(stems) - 1} more" if len(stems) > 1 else "")
        + ") has no `agents=(...)` tuple to generate into"
        for bundle, stems in sorted(grouped.items())
        if bundle not in spans
    ]
    if errors:
        return None, errors

    new_text = install_text
    for bundle, (start, end) in sorted(
        spans.items(), key=lambda kv: kv[1][0], reverse=True
    ):
        new_text = (
            new_text[:start]
            + render_install_tuple_body(grouped.get(bundle, []))
            + new_text[end:]
        )
    return new_text, []


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Generate/validate rules/common/performance.md's agent list and "
            "install.py's bundle tuples from agents/*.md frontmatter."
        ),
        epilog=(
            "Default: check mode -- diff the generated artifacts against disk and "
            "fail on divergence or incomplete frontmatter. --write: regenerate and save."
        ),
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=ROOT,
        help="Repo root (default: this script's repo)",
    )
    parser.add_argument(
        "--write",
        action="store_true",
        help="Write regenerated artifacts to disk instead of only checking them",
    )
    args = parser.parse_args(argv)

    root: Path = args.root
    agents_dir = root / "agents"
    performance_md = root / "rules" / "common" / "performance.md"
    install_py = root / "install.py"

    agents, errors = load_agents(agents_dir)
    if errors:
        print("lint-agent-models: incomplete agent frontmatter:", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1

    try:
        perf_text = performance_md.read_text()
    except FileNotFoundError:
        print(f"lint-agent-models: {performance_md} not found", file=sys.stderr)
        return 1
    try:
        install_text = install_py.read_text()
    except FileNotFoundError:
        print(f"lint-agent-models: {install_py} not found", file=sys.stderr)
        return 1

    new_perf_text = replace_marked_region(
        perf_text, PERF_REGION_START, PERF_REGION_END, render_performance_block(agents)
    )
    if new_perf_text is None:
        print(
            f"lint-agent-models: {performance_md} is missing the generated-region markers",
            file=sys.stderr,
        )
        return 1

    new_install_text, install_errors = regenerate_install_py(install_text, agents)
    if install_errors:
        print(
            "lint-agent-models: cannot generate install.py bundle tuples:",
            file=sys.stderr,
        )
        for e in install_errors:
            print(f"  - {e}", file=sys.stderr)
        return 1
    assert new_install_text is not None

    changed = [
        p
        for p, old, new in (
            (performance_md, perf_text, new_perf_text),
            (install_py, install_text, new_install_text),
        )
        if old != new
    ]

    if args.write:
        if new_perf_text != perf_text:
            performance_md.write_text(new_perf_text)
        if new_install_text != install_text:
            install_py.write_text(new_install_text)
        where = (
            f" -- wrote {', '.join(str(p.relative_to(root)) for p in changed)}"
            if changed
            else " -- already up to date"
        )
        print(f"lint-agent-models: regenerated from {len(agents)} agent files{where}")
        return 0

    if changed:
        print("lint-agent-models: generated artifacts are stale:", file=sys.stderr)
        for p in changed:
            print(
                f"  - {p.relative_to(root)} does not match agents/*.md frontmatter "
                "-- run `bin/lint-agent-models --write`",
                file=sys.stderr,
            )
        return 1

    print(
        f"lint-agent-models: {len(agents)} agents in sync across frontmatter, "
        "performance.md, and install.py"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
