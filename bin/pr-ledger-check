#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Verify a mine-address-pr-issues review ledger against the feedback it was built from.

The ledger (see skills/mine-address-pr-issues/ledger-procedure.md) must hold one
row per input item, every row must carry the fields its shape requires, and its
convergences must agree with the row labels. A finding that silently drops out of
triage is indistinguishable from one that was never raised, so completeness is
checked mechanically rather than trusted.

Exit codes: 0 = ledger is complete and consistent, 1 = problems found (listed on
stdout), 2 = an input file is missing or not valid JSON.
"""

import argparse
import json
import sys
from collections.abc import Callable
from pathlib import Path

MECHANISM_PREVIEW_CHARS = 60  # enough to tell convergences apart in a problem line

# GitHub surfaces whose items are keyed by url and may bundle embedded findings.
COMMENT_SURFACES = ("reviewComments", "issueComments")

VALID_STATUSES = {"open", "resolved"}
VALID_DISPOSITIONS = {"actionable", "already-addressed", "not-actionable", "duplicate"}
VALID_AUTHOR_KINDS = {"bot", "human", "self"}
VALID_DEPTHS = {"light", "medium", "deep"}
VALID_OUTCOMES = {"fixed", "declined", "deferred", "withdrawn"}


def _non_empty_str(value: object) -> bool:
    return isinstance(value, str) and value.strip() != ""


def _non_empty_list(value: object) -> bool:
    return isinstance(value, list) and len(value) > 0


def _is_resolved(row: dict) -> bool:
    return row.get("status") == "resolved"


def _is_open_actionable(row: dict) -> bool:
    return row.get("status") == "open" and row.get("disposition") == "actionable"


def _is_duplicate(row: dict) -> bool:
    return row.get("disposition") == "duplicate"


def _always(_row: dict) -> bool:
    return True


# Each field's contract: when a row needs it, and what makes its value valid.
# This is the one place the ledger's field requirements live — a downstream
# consumer (plan renderer, worker dispatch, thread resolver) that starts
# depending on a new field adds one entry here instead of a bespoke check, so
# the requirement can't drift out of sync with what the field is validated to
# contain.
FIELD_REQUIREMENTS: dict[str, tuple[Callable[[dict], bool], Callable[[object], bool]]] = {
    "status": (_always, lambda v: v in VALID_STATUSES),
    "disposition": (_always, lambda v: v in VALID_DISPOSITIONS),
    "author_kind": (_always, lambda v: v in VALID_AUTHOR_KINDS),
    "mechanism": (_always, _non_empty_str),
    "disposition_reason": (_always, _non_empty_str),
    "outcome": (_is_resolved, lambda v: v in VALID_OUTCOMES),
    "finding": (_is_open_actionable, _non_empty_str),
    "root_cause": (_is_open_actionable, _non_empty_str),
    "proposed_fix": (_is_open_actionable, _non_empty_str),
    "depth": (_is_open_actionable, lambda v: v in VALID_DEPTHS),
    "related": (_is_duplicate, _non_empty_list),
}


def _valid_embedded_count(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value >= 0


def input_items(feedback: dict | list) -> tuple[set[str], set[str]]:
    """Return (ids every ledger must cover, ids that may carry embedded `<id>#<n>` rows).

    GitHub: threads by id, review bodies and conversation comments by url; only the
    url-keyed items can bundle several findings, so only they take embedded rows.
    ADO (a bare list of threads): every thread by id, and any thread may be
    general conversation carrying embedded findings.
    """
    if isinstance(feedback, list):
        ids = {str(t["id"]) for t in feedback}
        return ids, ids
    urls = {c["url"] for s in COMMENT_SURFACES for c in feedback.get(s, [])}
    return {str(t["id"]) for t in feedback.get("threads", [])} | urls, urls


def check_ledger(feedback: dict | list, ledger: dict) -> list[str]:
    """Return a list of human-readable problems; empty means the ledger passes."""
    problems: list[str] = []
    rows = ledger.get("rows", [])
    problems += [
        f"row {n} has no id" for n, r in enumerate(rows) if r.get("id") is None
    ]
    rows = [r for r in rows if r.get("id") is not None]
    row_ids = [str(r["id"]) for r in rows]
    by_id = {str(r["id"]): r for r in rows}

    dupes = sorted({i for i in row_ids if row_ids.count(i) > 1})
    problems += [f"duplicate row id: {i}" for i in dupes]

    expected, embeddable = input_items(feedback)
    problems += [f"input item has no row: {i}" for i in sorted(expected - set(by_id))]

    for rid, row in by_id.items():
        # Check `rid in expected` first: GitHub urls already contain a `#fragment`, so a
        # url-keyed item's own row would otherwise be mistaken for an embedded row.
        if rid not in expected and rid.rsplit("#", 1)[0] not in embeddable:
            problems.append(
                f"row {rid} is neither an input item nor an embedded row of a review body, conversation comment, or ADO thread"
            )

        for field, (needed, valid) in FIELD_REQUIREMENTS.items():
            if needed(row) and not valid(row.get(field)):
                problems.append(f"row {rid} has invalid {field}: {row.get(field)!r}")

        # Embedded-finding coverage is self-reported: the ledger subagent read the
        # full text and knows how many findings it split into their own rows, so it
        # declares `embedded_count` on the parent row. The check is then purely
        # mechanical — do that many `<rid>#<n>` rows actually exist — with no regex
        # trying to recognize every reviewer tool's markup for "N findings here."
        if rid in embeddable:
            count = row.get("embedded_count")
            if not _valid_embedded_count(count):
                problems.append(
                    f"row {rid} has no valid embedded_count (must be a non-negative integer)"
                )
            else:
                actual = sum(
                    1 for other in row_ids if other.rsplit("#", 1)[0] == rid and other != rid
                )
                if actual != count:
                    problems.append(
                        f"{rid} declares embedded_count={count} but has {actual} embedded row(s)"
                    )

    for n, conv in enumerate(ledger.get("convergences", [])):
        mechanism = conv.get("mechanism")
        members_raw = conv.get("members", [])
        members = {str(m) for m in members_raw}
        label = f"convergence {n} ({str(mechanism)[:MECHANISM_PREVIEW_CHARS]!r})"

        missing = [
            field_name
            for field_name, value in (
                ("mechanism", mechanism),
                ("members", members_raw),
                ("summary", conv.get("summary")),
                ("open_questions", conv.get("open_questions")),
            )
            if not value or (isinstance(value, str) and not value.strip())
        ]
        if missing:
            problems.append(f"{label}: missing {', '.join(missing)}")
            continue

        problems += [
            f"{label}: member {m} is not a row" for m in sorted(members - set(by_id))
        ]
        present = members & set(by_id)
        problems += [
            f"{label}: member {m} is labelled {by_id[m].get('mechanism')!r}"
            for m in sorted(present)
            if by_id[m].get("mechanism") != mechanism
        ]
        labelled = {rid for rid, r in by_id.items() if r.get("mechanism") == mechanism}
        problems += [
            f"{label}: row {m} carries this mechanism but is not a member"
            for m in sorted(labelled - members)
        ]
    return problems


def load(path: Path) -> dict | list:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        print(f"error: cannot read {path}: {exc}", file=sys.stderr)
        sys.exit(2)


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="pr-ledger-check",
        description="Verify a PR review ledger covers every input item and that its convergences match its row labels.",
    )
    parser.add_argument(
        "feedback",
        type=Path,
        help="gh-pr-threads --json --all or ado-api pr threads --json --all output",
    )
    parser.add_argument(
        "ledger", type=Path, help="ledger JSON written by the ledger subagent"
    )
    args = parser.parse_args()

    feedback, ledger = load(args.feedback), load(args.ledger)
    problems = check_ledger(feedback, ledger)
    if problems:
        print(f"{len(problems)} problem(s):")
        print("\n".join(f"  - {p}" for p in problems))
        sys.exit(1)
    rows = ledger.get("rows", [])
    open_actionable = sum(
        1
        for r in rows
        if r.get("status") == "open" and r.get("disposition") == "actionable"
    )
    print(
        f"ok: {len(input_items(feedback)[0])} input items, {len(rows)} rows, "
        f"{len(ledger.get('convergences', []))} convergence(s), {open_actionable} open actionable"
    )


if __name__ == "__main__":
    main()
