#!/usr/bin/env bash
# Detect CLAUDE.md review-question files whose referenced code was modified
# by the current branch's diff.
#
# Usage: check-review-questions [<base>]
#   <base>  Comparison ref. Defaults to origin/<default-branch>.
#
# Output (stdout): one block per affected CLAUDE.md file listing which changed
# files it references. Empty output = nothing to flag.
# Exit: always 0.

set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat << 'EOF'
Usage: check-review-questions [<base>]

Detect CLAUDE.md review-question files whose referenced code was modified
by the current branch's diff.

Arguments:
  <base>    Comparison ref (default: origin/<default-branch>)

Output:
  Prints flagged CLAUDE.md files and the changed files they reference.
  Empty output means nothing to flag. Always exits 0.
EOF
  exit 0
fi

base="${1:-origin/$(git-default-branch)}"

mapfile -t changed < <(git diff --name-only "$base"...HEAD 2> /dev/null || true)
[[ ${#changed[@]} -eq 0 ]] && exit 0

# Build lookup of changed basenames → full paths (a basename can appear more
# than once if files in different directories share a name).
declare -A basename_to_paths
for f in "${changed[@]}"; do
  bn="$(basename "$f")"
  basename_to_paths["$bn"]+="$f"$'\n'
done

# Collect tracked CLAUDE.md files (skip repo-root CLAUDE.md — that's project
# config, not a module review-question file).
mapfile -t claude_files < <(
  git ls-files -- '**/CLAUDE.md' 2> /dev/null |
    grep -v '^CLAUDE\.md$' || true
)
[[ ${#claude_files[@]} -eq 0 ]] && exit 0

found=false
for claude_md in "${claude_files[@]}"; do
  [[ -f "$claude_md" ]] || continue
  content=$(< "$claude_md")

  # Only check files that look like review-question docs.
  grep -qiE 'review question|when reviewing' <<< "$content" || continue

  # Extract file-like references from backtick-quoted spans. Strip backticks
  # and trailing parens (function calls like `build_manifest_info()`).
  # Extension list covers common source/config types; extend as needed.
  mapfile -t refs < <(
    grep -oE '`[^`]*\.(py|ts|tsx|js|jsx|rs|go|rb|java|yaml|yml|toml|json|sh|sql|css|html)[^`]*`' <<< "$content" |
      sed 's/`//g; s/(.*//' |
      sort -u
  )
  [[ ${#refs[@]} -eq 0 ]] && continue

  matches=()
  for ref in "${refs[@]}"; do
    ref_bn="$(basename "$ref")"
    paths="${basename_to_paths[$ref_bn]:-}"
    [[ -z "$paths" ]] && continue

    while IFS= read -r p; do
      [[ -z "$p" ]] && continue
      # If the reference includes a path fragment (not just a basename), verify
      # the changed file's path ends with it.
      if [[ "$ref" == */* ]]; then
        [[ "$p" == *"$ref" ]] || continue
      fi
      matches+=("  $p  (referenced as \`$ref\`)")
    done <<< "$paths"
  done

  if [[ ${#matches[@]} -gt 0 ]]; then
    $found || echo "CLAUDE.md review-question files affected by this branch:"
    found=true
    echo ""
    echo "$claude_md"
    printf '%s\n' "${matches[@]}"
  fi
done

if $found; then
  echo ""
  echo "Check whether the review questions are still valid — or whether the"
  echo "code changes invalidate them. The developer decides which is wrong:"
  echo "the question or the code."
fi
