#!/usr/bin/env bash
# Detect REVIEW.md files whose referenced code was modified by the current
# branch's diff. REVIEW.md files contain review questions that reviewers
# read explicitly — separate from CLAUDE.md to avoid auto-injection into
# non-reviewer agents.
#
# Usage: check-review-questions [<base>]
#   <base>  Comparison ref. Defaults to origin/<default-branch>.
#
# Output (stdout): one block per affected REVIEW.md file listing which
# changed files it references. Empty output = nothing to flag.
# Exit: always 0.
#
# shellcheck disable=SC2154  # repo_root, base, changed are set by sourcing .review-md-lib.sh

set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat << 'EOF'
Usage: check-review-questions [<base>]

Detect REVIEW.md files whose referenced code was modified by the current
branch's diff.

Arguments:
  <base>    Comparison ref (default: origin/<default-branch>)

Output:
  Prints flagged REVIEW.md files and the changed files they reference.
  Empty output means nothing to flag. Always exits 0.
EOF
  exit 0
fi

_review_md_label="check review questions"
_review_md_base="${1:-}"
_self="$(readlink -f -- "${BASH_SOURCE[0]}")"
# shellcheck source=.review-md-lib.sh
source "$(dirname -- "$_self")/.review-md-lib.sh"

# Build lookup of changed basenames → full paths (a basename can appear more
# than once if files in different directories share a name).
declare -A basename_to_paths
for f in "${changed[@]}"; do
  bn="$(basename -- "$f")"
  basename_to_paths["$bn"]+="$f"$'\n'
done

# Collect tracked REVIEW.md files.
mapfile -t review_files < <(
  git ls-files -- '**/REVIEW.md' 'REVIEW.md' 2> /dev/null || true
)
[[ ${#review_files[@]} -eq 0 ]] && exit 0

found=false
for review_md in "${review_files[@]}"; do
  [[ -f "$review_md" ]] || continue
  content=$(< "$review_md")

  # Extract file-like references from backtick-quoted spans. Strip backticks,
  # trailing parens (function calls like `build_manifest_info()`),
  # line-number suffixes (`foo.py:42`), and anchor suffixes (`foo.py#L42`).
  mapfile -t refs < <(
    grep -oE '`[^`]*\.(py|ts|tsx|js|jsx|rs|go|rb|java|yaml|yml|toml|json|sh|sql|css|scss|html|vue|svelte|astro|md)[^`]*`' <<< "$content" |
      sed 's/`//g; s/(.*//; s/#.*$//; s/:[0-9][0-9]*$//' |
      sort -u
  )
  [[ ${#refs[@]} -eq 0 ]] && continue

  matches=()
  review_dir="$(dirname -- "$review_md")"
  for ref in "${refs[@]}"; do
    effective_ref="$ref"
    if [[ "$ref" == ../* || "$ref" == ./* || "$ref" != */* ]]; then
      # Relative or bare reference - resolve relative to this REVIEW.md's
      # own directory rather than matching any file with the same basename
      # anywhere in the repo.
      effective_ref="$(realpath -m --relative-to="$repo_root" "$repo_root/$review_dir/$ref" 2> /dev/null)" || effective_ref="$ref"
    fi

    ref_bn="$(basename -- "$effective_ref")"
    paths="${basename_to_paths[$ref_bn]:-}"
    [[ -z "$paths" ]] && continue

    while IFS= read -r p; do
      [[ -z "$p" ]] && continue
      [[ "$p" == "$effective_ref" ]] || continue
      matches+=("  $p  (referenced as \`$ref\`)")
    done <<< "$paths"
  done

  if [[ ${#matches[@]} -gt 0 ]]; then
    $found || echo "REVIEW.md files affected by this branch:"
    found=true
    echo ""
    echo "$review_md"
    printf '%s\n' "${matches[@]}"
  fi
done

if $found; then
  echo ""
  echo "Check whether the review questions are still valid — or whether the"
  echo "code changes invalidate them. The developer decides which is wrong:"
  echo "the question or the code."
fi
