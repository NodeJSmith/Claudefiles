#!/usr/bin/env bash
# List REVIEW.md files applicable to the current branch's diff: for every
# directory containing a changed file, walk up to the repo root and print
# any REVIEW.md found at or above that directory (deduped). Reviewer agents
# shell out to this instead of freehand-reimplementing the ancestor walk.
#
# Callers (code-reviewer, integration-reviewer, wtf-reviewer) run this
# pre-commit, against uncommitted changes — so unlike check-review-coverage
# and check-review-questions (whose only caller runs post-commit), this
# script discovers changed files itself rather than sourcing
# .review-md-lib.sh's committed-diff-only resolution. It uses the same
# uncommitted-first cascade the three reviewer agents already document in
# their own Step 1.
#
# Usage: find-review-md [<base>]
#        find-review-md --paths < file-list
#   <base>    Comparison ref. If given, overrides the cascade below with a
#             three-dot diff against this ref.
#   --paths   Read repo-relative file paths from stdin (one per line)
#             instead of discovering them — for a caller that already has
#             an explicit, scoped file list (mine-review path mode, the
#             orchestrate pipeline) and must not let this script's own
#             fallback cascade substitute an unrelated diff.
#
# Output (stdout): one REVIEW.md path per line, repo-relative, deduped.
# Empty output = no REVIEW.md applies to this diff.
# Exit: always 0.
#
# Changed-file discovery cascade (no <base>/--paths given): uncommitted
# changes (staged + unstaged + untracked) → @{upstream}...HEAD → the
# resolved default branch, tried as both origin/<default-branch>...HEAD
# and <default-branch>...HEAD (a local-only checkout has no origin/
# prefix to diff against) → HEAD~1.

set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat << 'EOF'
Usage: find-review-md [<base>]
       find-review-md --paths < file-list

List REVIEW.md files applicable to the current branch's diff — walking up
from each changed file's directory to the repo root.

Changed-file discovery (no <base>/--paths given): uncommitted changes
first (staged + unstaged + untracked), then @{upstream}...HEAD, then the
resolved default branch — tried as both origin/<default-branch>...HEAD
and <default-branch>...HEAD — then HEAD~1. Same cascade the reviewer
agents that call this script document in their own Step 1.

Arguments:
  <base>    Comparison ref. Overrides the cascade with a three-dot diff
            against this ref instead.
  --paths   Read repo-relative file paths from stdin (one per line)
            instead of discovering them. Use this when the caller
            already has an explicit, scoped file list — self-discovery
            would ignore that scope and substitute its own diff.

Output:
  One REVIEW.md path per line, repo-relative, deduped. Empty = none apply.
  Always exits 0.
EOF
  exit 0
fi

# `mapfile -t arr <<< "$s"` on an empty $s yields a one-element array
# containing "" (a trailing-newline artifact of <<<), not a zero-length
# array — so `${#changed[@]} -eq 0` alone doesn't catch "diff produced no
# files." This helper checks both, and the `-z` half is load-bearing for
# --paths too, not just the `<<<` git-diff branches: the documented caller
# pattern `printf '%s\n' "${files[@]}"` still emits one empty line when
# the array is empty (printf with a %s conversion and zero arguments runs
# the format once against an empty string), so `mapfile -t changed` on
# that input is a one-element array containing "", identical to the <<<
# case in effect even though it arrives via a plain pipe.
changed_is_empty() {
  [[ ${#changed[@]} -eq 0 || -z "${changed[0]}" ]]
}

repo_root="$(git rev-parse --show-toplevel 2> /dev/null)" || exit 0
cd "$repo_root" || exit 0

if [[ "${1:-}" == "--paths" ]]; then
  if [[ -t 0 ]]; then
    echo "WARNING: --paths expects a file list on stdin; none was piped in" >&2
    exit 0
  fi
  mapfile -t changed
elif [[ -n "${1:-}" ]]; then
  base="$1"
  if ! diff_output="$(git diff --name-only "$base"...HEAD 2> /dev/null)"; then
    echo "WARNING: git diff against $base failed; cannot find applicable REVIEW.md files" >&2
    exit 0
  fi
  mapfile -t changed <<< "$diff_output"
else
  mapfile -t changed < <(
    {
      git diff --name-only HEAD 2> /dev/null
      git ls-files --others --exclude-standard 2> /dev/null
    } | sort -u
  )
  if changed_is_empty; then
    diff_output="$(git diff --name-only "@{upstream}...HEAD" 2> /dev/null)" || diff_output=""
    mapfile -t changed <<< "$diff_output"
  fi
  if changed_is_empty; then
    default_branch="$(git-default-branch 2> /dev/null)" || default_branch=""
    if [[ -n "$default_branch" ]]; then
      diff_output="$(git diff --name-only "origin/$default_branch...HEAD" 2> /dev/null)" ||
        diff_output="$(git diff --name-only "$default_branch...HEAD" 2> /dev/null)" || diff_output=""
      mapfile -t changed <<< "$diff_output"
    fi
  fi
  if changed_is_empty; then
    diff_output="$(git diff --name-only HEAD~1 2> /dev/null)" || diff_output=""
    mapfile -t changed <<< "$diff_output"
  fi
fi

if changed_is_empty; then
  exit 0
fi

declare -A seen
for f in "${changed[@]}"; do
  dir="$(dirname -- "$f")"
  current="$repo_root/$dir"
  [[ "$dir" == "." ]] && current="$repo_root"
  while :; do
    if [[ -f "$current/REVIEW.md" ]]; then
      if [[ "$current" == "$repo_root" ]]; then
        rel="REVIEW.md"
      else
        rel="${current#"$repo_root"/}/REVIEW.md"
      fi
      if [[ -z "${seen[$rel]:-}" ]]; then
        seen["$rel"]=1
        echo "$rel"
      fi
    fi
    [[ "$current" == "$repo_root" || "$current" == "/" ]] && break
    current="$(dirname -- "$current")"
  done
done
