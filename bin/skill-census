#!/usr/bin/env python3
"""Count skill invocations across Claude Code transcripts, including never-invoked skills.

A skill is invoked two ways, and both are counted:
  - tool:  the model calls the Skill tool (a `tool_use` block named "Skill")
  - slash: the user types `/x` (`<command-name>/x</command-name>` in the user message)

Counting only the Skill tool undercounts user-driven skills badly. A slash command and
a Skill tool call for the same skill in one turn are one invocation, so `total` counts
each skill once per turn; `tool` and `slash` are per-method counts and can sum to more
than `total`.
Transcripts of subagents (`subagents/` directories) are excluded: only main sessions count.

Usage: skill-census [--days N] [--skills-dir DIR]... [--zero-only]
"""

import argparse
import json
import os
import re
import sys
import time
from collections import Counter
from pathlib import Path

DEFAULT_DAYS = 60
DEFAULT_SKILLS_DIR = Path(__file__).resolve().parent.parent / "skills"
SLASH_RE = re.compile(r"<command-name>/([^<]+)</command-name>")


def config_dir() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def transcripts(projects_dir: Path, days: int):
    cutoff = time.time() - days * 86400
    # One level deep on purpose: subagent transcripts live under <session>/subagents/,
    # so this glob counts main sessions only. Do not widen it to "**".
    for path in projects_dir.glob("*/*.jsonl"):
        if path.stat().st_mtime >= cutoff:
            yield path


def content_blocks(message: dict) -> list[dict]:
    content = message.get("content")
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    return [b for b in content or [] if isinstance(b, dict)]


def count_invocations(paths) -> tuple[Counter, Counter, Counter]:
    """Return (total, tool, slash) counters; total counts each skill once per turn.

    A turn starts at a user message that is not a tool_result or an isMeta entry.
    """
    total, tool, slash = Counter(), Counter(), Counter()
    for path in paths:
        turn: set[str] = set()
        with path.open(errors="replace") as fh:
            for line in fh:
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                message = entry.get("message")
                if not isinstance(message, dict):
                    continue
                blocks = content_blocks(message)
                if entry.get("type") == "user":
                    # tool_result and isMeta (injected skill body) entries belong to
                    # the turn already in progress.
                    if entry.get("isMeta") or any(
                        b.get("type") == "tool_result" for b in blocks
                    ):
                        continue
                    total.update(turn)
                    turn = set()
                    for b in blocks:
                        for name in SLASH_RE.findall(b.get("text", "")):
                            slash[name] += 1
                            turn.add(name)
                elif entry.get("type") == "assistant":
                    for b in blocks:
                        if b.get("type") == "tool_use" and b.get("name") == "Skill":
                            name = (b.get("input") or {}).get("skill")
                            if name:
                                tool[name] += 1
                                turn.add(name)
        total.update(turn)
    return total, tool, slash


def installed_skills(skills_dirs: list[Path]) -> set[str]:
    return {
        d.name
        for base in skills_dirs
        for d in base.iterdir()
        if (d / "SKILL.md").exists()
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--days",
        type=int,
        default=DEFAULT_DAYS,
        help="look-back window by transcript mtime (default: %(default)s)",
    )
    parser.add_argument(
        "--skills-dir",
        type=Path,
        action="append",
        help="directory of skill folders (default: the repo skills/); repeatable",
    )
    parser.add_argument(
        "--zero-only", action="store_true", help="print only skills with no invocations"
    )
    args = parser.parse_args()

    skills_dirs = args.skills_dir or [DEFAULT_SKILLS_DIR]
    missing = [str(d) for d in skills_dirs if not d.is_dir()]
    if missing:
        print(f"error: skills dir not found: {', '.join(missing)}", file=sys.stderr)
        return 2

    projects_dir = config_dir() / "projects"
    if not projects_dir.is_dir():
        print(
            f"error: no transcripts directory at {projects_dir} (set CLAUDE_CONFIG_DIR)",
            file=sys.stderr,
        )
        return 2
    paths = list(transcripts(projects_dir, args.days))
    total, tool, slash = count_invocations(paths)
    print(f"{len(paths)} transcripts in the last {args.days} days", file=sys.stderr)

    installed = installed_skills(skills_dirs)
    rows = sorted(
        ((name, total[name], tool[name], slash[name]) for name in installed),
        key=lambda r: (-r[1], r[0]),
    )
    if args.zero_only:
        rows = [r for r in rows if r[1] == 0]

    print(
        json.dumps(
            [{"skill": n, "total": c, "tool": t, "slash": s} for n, c, t, s in rows],
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
